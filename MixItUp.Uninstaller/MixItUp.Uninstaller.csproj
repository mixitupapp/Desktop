<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net48</TargetFramework>
		<UseWPF>true</UseWPF>
		<AssemblyName>MixItUp.Uninstaller</AssemblyName>
		<RootNamespace>MixItUp.Uninstaller</RootNamespace>
		<ApplicationIcon>Logo.ico</ApplicationIcon>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<LangVersion>latest</LangVersion>
		<Nullable>disable</Nullable>
		<AssemblyTitle>MixItUp.Uninstaller</AssemblyTitle>
		<Product>MixItUp.Uninstaller</Product>
		<Description>Mix It Up Desktop Uninstaller</Description>
		<Company>Blazing Cacti LLC</Company>
		<Copyright>Copyright © 2026 Blazing Cacti LLC, All Rights Reserved.</Copyright>
		<AssemblyVersion>0.6.0.0</AssemblyVersion>
		<FileVersion>0.6.0.0</FileVersion>
		<Version>0.6.0</Version>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="MaterialDesignThemes" Version="5.3.0" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Logo.ico" />
		<Resource Include="Logo.png" />
	</ItemGroup>
</Project>