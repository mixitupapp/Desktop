<Windows:LoadingWindowBase
    x:Class="MixItUp.WPF.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:MixItUp.WPF.Controls"
    xmlns:MaterialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:Windows="clr-namespace:MixItUp.WPF.Windows"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:MixItUp.Base;assembly=MixItUp.Base"
    Title="{x:Static resx:Resources.MixItUpLogin}"
    Width="680"
    Height="500"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="{MaterialDesign:MaterialDesignFont}"
    Icon="./Logo.ico"
    ResizeMode="NoResize"
    TextElement.FontSize="14"
    TextElement.FontWeight="Medium"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <Grid>
        <MaterialDesign:DialogHost x:Name="MDDialogHost" Identifier="RootDialog">
            <Border
                BorderBrush="White"
                BorderThickness="2"
                CornerRadius="28">
                <MaterialDesign:Card
                    Padding="16,20,16,0"
                    MaterialDesign:ElevationAssist.Elevation="Dp8"
                    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                    UniformCornerRadius="28">
                    <MaterialDesign:Card.Background>
                        <ImageBrush ImageSource="/Assets/Images/MixItUp_Background-Starfield.png" Stretch="UniformToFill" />
                    </MaterialDesign:Card.Background>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!--Close Button-->
                            <RowDefinition Height="*" />    <!--Branding and Login Options-->
                            <RowDefinition Height="56" />   <!--Patreon Row-->
                            <RowDefinition Height="Auto" /> <!--Footer-->
                            <RowDefinition Height="Auto" /> <!--Status Bar-->
                        </Grid.RowDefinitions>

                     
                        <Button
                        Grid.Row="0"
                        Width="32"
                        Height="32"
                        Margin="0,-10,-10,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Click="CloseButton_Click"
                        Style="{StaticResource MaterialDesignIconButton}"
                        ToolTip="Close">
                            <MaterialDesign:PackIcon
                                Foreground="{StaticResource MIU.Brush.Dark.Primary}"
                            
                            Width="20"
                            Height="20"
                            Kind="Close" />
                        </Button>

                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <Image
                                Width="210"
                                HorizontalAlignment="Center"
                                Source="/Assets/Images/MixItUp_Logo-Stacked_Dark.png"
                                Stretch="Uniform" />
                            </StackPanel>

                            <StackPanel
                            Grid.Column="2"
                            Width="280"
                            VerticalAlignment="Center">

                                <StackPanel x:Name="ExistingProfilePanel" Visibility="Collapsed">

                                <TextBlock
                                Margin="0,0,0,8"
                                Foreground="White"
                                Style="{StaticResource HeadlineMedium}"
                                TextAlignment="Right"
                                Text="{x:Static resx:Resources.ExistingProfile}" />

                                <ComboBox
                                    x:Name="ExistingStreamerComboBox"
                                    Margin="0,0,0,10"
                                    MaterialDesign:ThemeAssist.Theme="Dark"
                                    DisplayMemberPath="Name"
                                    Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                    Foreground="White"
                                    BorderBrush="White" >
                                </ComboBox>

                                <Button
                                x:Name="StreamerLoginButton"
                                Height="40"
                                Margin="0,0,0,16"
                                    Foreground="{StaticResource MIU.Brush.Dark.OnPrimary}"
                                    Background="{StaticResource MIU.Brush.Dark.Primary}"
                                MaterialDesign:ButtonAssist.CornerRadius="20"
                                Click="StreamerLoginButton_Click"
                              
                                FontSize="14"
                                IsEnabled="False"
                                Style="{StaticResource MaterialDesignRaisedButton}" >
                                    <TextBlock 
                                        Style="{StaticResource LabelLarge}" 
                                        Text="{x:Static resx:Resources.Login}"
                                        />
                                </Button>

                                </StackPanel>

                                <TextBlock
                                Margin="0,0,0,8"
                                Foreground="White"
                                Style="{StaticResource HeadlineMedium}"
                                TextAlignment="Right"
                                Text="{x:Static resx:Resources.NewProfile}" />

                                <Button
                                x:Name="NewStreamerLoginButton"
                                Height="40"
                                Margin="0,0,0,10"
                                MaterialDesign:ButtonAssist.CornerRadius="20"
                                Foreground="{StaticResource MIU.Brush.Dark.OnSecondary}"
                                Background="{StaticResource MIU.Brush.Dark.Secondary}"
                                Click="NewStreamerLoginButton_Click"
                                Style="{StaticResource MaterialDesignRaisedButton}" >
                                    <TextBlock 
                                        Style="{StaticResource LabelLarge}" 
                                        Text="{x:Static resx:Resources.NewProfile}" />
                                </Button>

                                <Button
                                x:Name="RestoreBackupButton"
                                Height="40"
                                MaterialDesign:ButtonAssist.CornerRadius="20"
                                Foreground="{StaticResource MIU.Brush.Dark.Secondary}" 
                                BorderBrush="{StaticResource MIU.Brush.Dark.Secondary}"
                                Click="RestoreBackupButton_Click"  
                                Style="{StaticResource MaterialDesignOutlinedButton}" >
                                    <TextBlock 
                                        Style="{StaticResource LabelLarge}" 
                                        Text="{x:Static resx:Resources.RestoreSettings}" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <StackPanel
                        x:Name="PatreonShoutoutBorder"
                        Grid.Row="2"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Visibility="Collapsed">
                            <Border
                            Width="40"
                            Height="40"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Background="{StaticResource MIU.Brush.Dark.Primary}"
                            CornerRadius="20">
                                <Image
                                x:Name="PatreonMemberAvatarImage"
                                Width="36"
                                Height="36"
                                Stretch="UniformToFill">
                                    <Image.Clip>
                                        <EllipseGeometry
                                        Center="18,18"
                                        RadiusX="18"
                                        RadiusY="18" />
                                    </Image.Clip>
                                </Image>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Margin="4,0,0,0" Style="{StaticResource LabelMedium}">
   <Hyperlink x:Name="PatreonCTAHyperlink" Foreground="{StaticResource MIU.Brush.Dark.OnBackground}" NavigateUri="https://mixitupapp.com/patreon" RequestNavigate="Hyperlink_RequestNavigate" TextDecorations="{x:Null}"></Hyperlink>
                                </TextBlock>
                                <TextBlock Margin="4,0,0,0" Style="{StaticResource LabelMedium}">
                                <Hyperlink x:Name="PatreonShoutOutHyperlink" Foreground="{StaticResource MIU.Brush.Dark.OnBackground}" Click="PatreonShoutOutHyperlink_Click" TextDecorations="{x:Null}"></Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Margin="0,16,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                x:Name="VersionTextBlock"
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource MIU.Brush.Dark.OnBackground}"
                                Style="{StaticResource LabelSmall}" 
                                Text="[Version]"
                                />

                                <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                >
                                    <TextBlock
                                    Foreground="{StaticResource MIU.Brush.Dark.OnBackground}"
                                    Style="{StaticResource LabelSmall}" 
                                    Text="© 2026 Blazing Cacti LLC, All Rights Reserved" />
                                    <TextBlock
                                    Margin="8,0"
                                    Foreground="{StaticResource MIU.Brush.Dark.OnBackground}"
                                    Style="{StaticResource LabelSmall}" 
                                    Text="•" />
                                    <TextBlock Style="{StaticResource LabelSmall}">
                                    <Hyperlink
                                        Foreground="{StaticResource MIU.Brush.Dark.OnBackground}"
                                        NavigateUri="https://mixitupapp.com/TermsOfService"
                                        RequestNavigate="Hyperlink_RequestNavigate">
                                        <Run Text="{x:Static resx:Resources.TermsOfService}" />
                                    </Hyperlink>
                                    </TextBlock>
                                    <TextBlock
                                        Margin="8,0"
                                        Foreground="{StaticResource MIU.Brush.Dark.OnBackground}"
                                        Style="{StaticResource LabelSmall}" 
                                        Text="•" />
                                    <TextBlock Style="{StaticResource LabelSmall}">
                                        <Hyperlink
                                            Foreground="{StaticResource MIU.Brush.Dark.OnBackground}" 
                                            NavigateUri="https://mixitupapp.com/Privacy" 
                                            RequestNavigate="Hyperlink_RequestNavigate">
                                        <Run Text="{x:Static resx:Resources.PrivacyPolicy}" />
                                    </Hyperlink>
                                    </TextBlock>
                                </StackPanel>

                                <MaterialDesign:PopupBox
                                Grid.Column="2"
                                Width="24"
                                Height="24"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                PlacementMode="TopAndAlignRightEdges"
                                StaysOpen="False"
                                ToolTip="{x:Static resx:Resources.Help}">
                                    <MaterialDesign:PopupBox.ToggleContent>
                                        <MaterialDesign:PackIcon
                                        Foreground="{StaticResource MIU.Brush.Dark.Primary}"
                                        Width="20"
                                        Height="20"
                                        Kind="HelpCircle" />
                                    </MaterialDesign:PopupBox.ToggleContent>
                                    <StackPanel>
                                        <Button
                                        HorizontalContentAlignment="Left"
                                        Click="OpenInstallFolder_Click"
                                        Style="{StaticResource MaterialDesignFlatButton}">
                                            <StackPanel Orientation="Horizontal">
                                                <MaterialDesign:PackIcon
                                                Width="18"
                                                Height="18"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                Kind="Folder" />
                                                <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                                Text="{x:Static resx:Resources.InstallationFolder}" />
                                            </StackPanel>
                                        </Button>
                                        <Separator Margin="0,2" />
                                        <Button
                                        HorizontalContentAlignment="Left"
                                        Click="ResetWindowPosition_Click"
                                        Style="{StaticResource MaterialDesignFlatButton}">
                                            <StackPanel Orientation="Horizontal">
                                                <MaterialDesign:PackIcon
                                                Width="18"
                                                Height="18"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                Kind="WindowRestore" />
                                                <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                                Text="{x:Static resx:Resources.ResetWindowPosition}" />
                                            </StackPanel>
                                        </Button>
                                        <Separator Margin="0,2" />
                                        <Button
                                        HorizontalContentAlignment="Left"
                                        Click="OpenDiscord_Click"
                                        Style="{StaticResource MaterialDesignFlatButton}">
                                            <StackPanel Orientation="Horizontal">
                                                <Image
                                                Width="18"
                                                Height="18"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Source="/Assets/Images/discord-color_sm.png" />
                                                <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                                Text="{x:Static resx:Resources.Discord}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </MaterialDesign:PopupBox>
                            </Grid>
                        </StackPanel>

                        <Controls:LoadingStatusBar
                        x:Name="StatusBar"
                        BarColor="{StaticResource MIU.Brush.Dark.OnSecondaryContainer}"
                        BarBackground ="{StaticResource MIU.Brush.Dark.SecondaryContainer}"
                        BarHeight="8"
                        Grid.Row="4"
                        Margin="-28,0,-28,0" />

                        <MaterialDesign:Card
                        x:Name="OutageBanner"
                        Grid.Row="0"
                        Grid.RowSpan="6"
                        Margin="20,0,20,20"
                        Padding="16,12"
                        VerticalAlignment="Bottom"
                        UniformCornerRadius="8"
                        Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <MaterialDesign:PackIcon
                                x:Name="OutageIcon"
                                Grid.Column="0"
                                Width="24"
                                Height="24"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Foreground="White"
                                Kind="Information" />

                                <TextBlock
                                x:Name="OutageMessage"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="White"
                                TextWrapping="Wrap" />

                                <Button
                                x:Name="CloseOutageBannerButton"
                                Grid.Column="2"
                                Width="24"
                                Height="24"
                                Margin="12,0,0,0"
                                Padding="0"
                                Click="CloseOutageBannerButton_Click"
                                Style="{StaticResource MaterialDesignIconButton}"
                                ToolTip="Close">
                                    <MaterialDesign:PackIcon
                                    Width="18"
                                    Height="18"
                                    Foreground="White"
                                    Kind="Close" />
                                </Button>
                            </Grid>
                        </MaterialDesign:Card>
                    </Grid>
                </MaterialDesign:Card>
            </Border>
        </MaterialDesign:DialogHost>
    </Grid>
</Windows:LoadingWindowBase>
