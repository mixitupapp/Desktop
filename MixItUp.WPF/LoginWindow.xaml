<Windows:LoadingWindowBase
    x:Class="MixItUp.WPF.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:MixItUp.WPF.Controls"
    xmlns:MaterialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:Windows="clr-namespace:MixItUp.WPF.Windows"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:MixItUp.Base;assembly=MixItUp.Base"
    Title="{x:Static resx:Resources.MixItUpLogin}"
    Width="680"
    Height="500"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="{MaterialDesign:MaterialDesignFont}"
    Icon="./Logo.ico"
    ResizeMode="NoResize"
    TextElement.FontSize="14"
    TextElement.FontWeight="Medium"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <Grid>
        <MaterialDesign:DialogHost x:Name="MDDialogHost" Identifier="RootDialog">
            <MaterialDesign:Card
                Padding="28,20,28,0"
                MaterialDesign:ElevationAssist.Elevation="Dp8"
                Background="{DynamicResource MaterialDesign.Brush.Background}"
                Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                UniformCornerRadius="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Button
                        Grid.Row="0"
                        Width="32"
                        Height="32"
                        Margin="0,-10,-10,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Click="CloseButton_Click"
                        Style="{StaticResource MaterialDesignIconButton}"
                        ToolTip="Close">
                        <MaterialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Kind="Close" />
                    </Button>

                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <Image
                                Width="150"
                                Height="150"
                                HorizontalAlignment="Center"
                                Source="/Logo.png"
                                Stretch="Uniform" />
                            <TextBlock
                                Margin="0,6,0,0"
                                HorizontalAlignment="Center"
                                FontSize="28"
                                FontWeight="Bold"
                                Text="MIX IT UP" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="2"
                            Width="280"
                            VerticalAlignment="Center">

                            <TextBlock
                                Margin="0,0,0,8"
                                FontSize="14"
                                FontWeight="Bold"
                                Text="{x:Static resx:Resources.ExistingProfile}" />

                            <ComboBox
                                x:Name="ExistingStreamerComboBox"
                                Margin="0,0,0,10"
                                MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.Profile}"
                                DisplayMemberPath="Name"
                                FontSize="13"
                                Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                Visibility="Collapsed" />

                            <Button
                                x:Name="StreamerLoginButton"
                                Height="40"
                                Margin="0,0,0,16"
                                MaterialDesign:ButtonAssist.CornerRadius="20"
                                Click="StreamerLoginButton_Click"
                                Content="{x:Static resx:Resources.Login}"
                                FontSize="14"
                                IsEnabled="False"
                                Style="{StaticResource MaterialDesignRaisedButton}" />

                            <TextBlock
                                Margin="0,0,0,8"
                                FontSize="14"
                                FontWeight="Bold"
                                Text="{x:Static resx:Resources.NewProfile}" />

                            <Button
                                x:Name="NewStreamerLoginButton"
                                Height="40"
                                Margin="0,0,0,10"
                                MaterialDesign:ButtonAssist.CornerRadius="20"
                                Click="NewStreamerLoginButton_Click"
                                Content="{x:Static resx:Resources.NewProfile}"
                                FontSize="14"
                                Style="{StaticResource MaterialDesignRaisedButton}" />

                            <Button
                                x:Name="RestoreBackupButton"
                                Height="40"
                                MaterialDesign:ButtonAssist.CornerRadius="20"
                                Click="RestoreBackupButton_Click"
                                Content="{x:Static resx:Resources.RestoreSettings}"
                                FontSize="14"
                                Style="{StaticResource MaterialDesignOutlinedButton}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel
                        x:Name="PatreonShoutoutBorder"
                        Grid.Row="2"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Left"
                        Orientation="Horizontal"
                        Visibility="Collapsed">
                        <Border
                            Width="40"
                            Height="40"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource MaterialDesign.Brush.Primary}"
                            CornerRadius="20">
                            <Image
                                x:Name="PatreonMemberAvatarImage"
                                Width="36"
                                Height="36"
                                Stretch="UniformToFill">
                                <Image.Clip>
                                    <EllipseGeometry
                                        Center="18,18"
                                        RadiusX="18"
                                        RadiusY="18" />
                                </Image.Clip>
                            </Image>
                        </Border>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock
                                x:Name="PatreonMemberNameTextBlock"
                                FontSize="12"
                                Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                Opacity="0.95"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="11"
                                Opacity="0.85">
                                <Hyperlink NavigateUri="https://mixitupapp.com/patreon" RequestNavigate="Hyperlink_RequestNavigate">
                                    <Run Text="Learn more HERE" />
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="0,16,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                x:Name="VersionTextBlock"
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Opacity="0.7" />

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    FontSize="11"
                                    Opacity="0.8"
                                    Text="© 2026 Blazing Cacti LLC, All Rights Reserved" />
                                <TextBlock
                                    Margin="8,0"
                                    FontSize="11"
                                    Opacity="0.6"
                                    Text="•" />
                                <TextBlock FontSize="11">
                                    <Hyperlink NavigateUri="https://mixitupapp.com/TermsOfService" RequestNavigate="Hyperlink_RequestNavigate">
                                        <Run Text="{x:Static resx:Resources.TermsOfService}" />
                                    </Hyperlink>
                                </TextBlock>
                                <TextBlock
                                    Margin="8,0"
                                    FontSize="11"
                                    Opacity="0.6"
                                    Text="•" />
                                <TextBlock FontSize="11">
                                    <Hyperlink NavigateUri="https://mixitupapp.com/Privacy" RequestNavigate="Hyperlink_RequestNavigate">
                                        <Run Text="{x:Static resx:Resources.PrivacyPolicy}" />
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>

                            <MaterialDesign:PopupBox
                                Grid.Column="2"
                                Width="24"
                                Height="24"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                PlacementMode="TopAndAlignRightEdges"
                                StaysOpen="False"
                                ToolTip="{x:Static resx:Resources.Help}">
                                <MaterialDesign:PopupBox.ToggleContent>
                                    <MaterialDesign:PackIcon
                                        Width="20"
                                        Height="20"
                                        Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                        Kind="HelpCircle" />
                                </MaterialDesign:PopupBox.ToggleContent>
                                <StackPanel>
                                    <Button
                                        HorizontalContentAlignment="Left"
                                        Click="OpenInstallFolder_Click"
                                        Style="{StaticResource MaterialDesignFlatButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <MaterialDesign:PackIcon
                                                Width="18"
                                                Height="18"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                Kind="Folder" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                                Text="{x:Static resx:Resources.InstallationFolder}" />
                                        </StackPanel>
                                    </Button>
                                    <Separator Margin="0,2" />
                                    <Button
                                        HorizontalContentAlignment="Left"
                                        Click="ResetWindowPosition_Click"
                                        Style="{StaticResource MaterialDesignFlatButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <MaterialDesign:PackIcon
                                                Width="18"
                                                Height="18"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                Kind="WindowRestore" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                                Text="{x:Static resx:Resources.ResetWindowPosition}" />
                                        </StackPanel>
                                    </Button>
                                    <Separator Margin="0,2" />
                                    <Button
                                        HorizontalContentAlignment="Left"
                                        Click="OpenDiscord_Click"
                                        Style="{StaticResource MaterialDesignFlatButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <Image
                                                Width="18"
                                                Height="18"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Source="/Assets/Images/discord-color_sm.png" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                                Text="{x:Static resx:Resources.Discord}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </MaterialDesign:PopupBox>
                        </Grid>
                    </StackPanel>

                    <Controls:LoadingStatusBar
                        x:Name="StatusBar"
                        Grid.Row="4"
                        Margin="-28,0,-28,0" />

                    <MaterialDesign:Card
                        x:Name="OutageBanner"
                        Grid.Row="0"
                        Grid.RowSpan="6"
                        Margin="20,0,20,20"
                        Padding="16,12"
                        VerticalAlignment="Bottom"
                        UniformCornerRadius="8"
                        Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <MaterialDesign:PackIcon
                                x:Name="OutageIcon"
                                Grid.Column="0"
                                Width="24"
                                Height="24"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Foreground="White"
                                Kind="Information" />

                            <TextBlock
                                x:Name="OutageMessage"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="White"
                                TextWrapping="Wrap" />

                            <Button
                                x:Name="CloseOutageBannerButton"
                                Grid.Column="2"
                                Width="24"
                                Height="24"
                                Margin="12,0,0,0"
                                Padding="0"
                                Click="CloseOutageBannerButton_Click"
                                Style="{StaticResource MaterialDesignIconButton}"
                                ToolTip="Close">
                                <MaterialDesign:PackIcon
                                    Width="18"
                                    Height="18"
                                    Foreground="White"
                                    Kind="Close" />
                            </Button>
                        </Grid>
                    </MaterialDesign:Card>
                </Grid>
            </MaterialDesign:Card>
        </MaterialDesign:DialogHost>
    </Grid>
</Windows:LoadingWindowBase>
