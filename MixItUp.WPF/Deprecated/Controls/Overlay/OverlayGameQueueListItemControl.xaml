<local:OverlayItemControl x:Class="MixItUp.WPF.Controls.Overlay.OverlayGameQueueListItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MixItUp.WPF.Controls.Overlay"
             xmlns:resx="clr-namespace:MixItUp.Base;assembly=MixItUp.Base"
             xmlns:Util="clr-namespace:MixItUp.WPF.Util"
             xmlns:Controls="clr-namespace:MixItUp.WPF.Controls"
             xmlns:MaterialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <local:OverlayItemControl.Resources>
        <Util:LocalizationConverter x:Key="LocalizationConverter"/>
    </local:OverlayItemControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="15" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="15" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="15" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Text="{Binding TotalToShowString}" Grid.Column="0" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.TotalToShow}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Width="80" AutomationProperties.AutomationId="OverlayGameQueueListItem.TotalToShowTextBox" AutomationProperties.Name="{x:Static resx:Resources.TotalToShow}" />

            <TextBox Text="{Binding WidthString}" Grid.Column="2" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.ItemWidth}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Width="110" AutomationProperties.AutomationId="OverlayGameQueueListItem.ItemWidthTextBox" AutomationProperties.Name="{x:Static resx:Resources.ItemWidth}" />
            <TextBox Text="{Binding HeightString}" Grid.Column="4" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.ItemHeight}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Width="110" AutomationProperties.AutomationId="OverlayGameQueueListItem.ItemHeightTextBox" AutomationProperties.Name="{x:Static resx:Resources.ItemHeight}" />

            <ComboBox Grid.Column="6" x:Name="OverlayGameQueueListItemTextFontComboBox" Text="{Binding Font}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.TextFont}" Style="{StaticResource MaterialDesignFloatingHintComboBox}" IsEditable="True" Width="150" AutomationProperties.AutomationId="OverlayGameQueueListItem.TextFontComboBox" AutomationProperties.Name="{x:Static resx:Resources.TextFont}" />

        </Grid>

        <Grid Grid.Row="2" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="15" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="15" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox ItemsSource="{Binding ColorNames}" Text="{Binding BorderColor}" Grid.Column="0" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.BorderColor}" IsEditable="True" Style="{StaticResource MaterialDesignFloatingHintComboBox}" Width="120" AutomationProperties.AutomationId="OverlayGameQueueListItem.BorderColorComboBox" AutomationProperties.Name="{x:Static resx:Resources.BorderColor}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource LocalizationConverter}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <ComboBox ItemsSource="{Binding ColorNames}" Text="{Binding BackgroundColor}" Grid.Column="2" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.BackgroundColor}" IsEditable="True" Style="{StaticResource MaterialDesignFloatingHintComboBox}" Width="130" AutomationProperties.AutomationId="OverlayGameQueueListItem.BackgroundColorComboBox" AutomationProperties.Name="{x:Static resx:Resources.BackgroundColor}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource LocalizationConverter}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <ComboBox ItemsSource="{Binding ColorNames}" Text="{Binding TextColor}" Grid.Column="4" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.TextColor}" IsEditable="True" Style="{StaticResource MaterialDesignFloatingHintComboBox}" Width="120" AutomationProperties.AutomationId="OverlayGameQueueListItem.TextColorComboBox" AutomationProperties.Name="{x:Static resx:Resources.TextColor}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource LocalizationConverter}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <Grid Grid.Row="4" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="15" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="15" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox ItemsSource="{Binding Alignments}" SelectedItem="{Binding Alignment}" Grid.Column="0" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.ListAlignment}" Style="{StaticResource MaterialDesignFloatingHintComboBox}" Width="100" AutomationProperties.AutomationId="OverlayGameQueueListItem.ListAlignmentComboBox" AutomationProperties.Name="{x:Static resx:Resources.ListAlignment}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource LocalizationConverter}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <ComboBox ItemsSource="{Binding EntranceAnimations}" SelectedItem="{Binding EntranceAnimation}" Grid.Column="2" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.AddAnimation}" Style="{StaticResource MaterialDesignFloatingHintComboBox}" Width="125" AutomationProperties.AutomationId="OverlayGameQueueListItem.AddAnimationComboBox" AutomationProperties.Name="{x:Static resx:Resources.AddAnimation}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource LocalizationConverter}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <ComboBox ItemsSource="{Binding ExitAnimations}" SelectedItem="{Binding ExitAnimation}" Grid.Column="4" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.RemoveAnimation}" Style="{StaticResource MaterialDesignFloatingHintComboBox}" Width="125" AutomationProperties.AutomationId="OverlayGameQueueListItem.RemoveAnimationComboBox" AutomationProperties.Name="{x:Static resx:Resources.RemoveAnimation}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource LocalizationConverter}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <TextBox Text="{Binding HTML}" Grid.Row="6" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.HTMLStyle}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AcceptsReturn="True" Width="700" Height="150" VerticalAlignment="Top" HorizontalAlignment="Center" AutomationProperties.AutomationId="OverlayGameQueueListItem.HTMLStyleTextBox" AutomationProperties.Name="{x:Static resx:Resources.HTMLStyle}" />
    </Grid>
</local:OverlayItemControl>
