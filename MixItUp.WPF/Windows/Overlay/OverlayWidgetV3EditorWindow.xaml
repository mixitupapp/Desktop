<Windows:LoadingWindowBase
    x:Class="MixItUp.WPF.Windows.Overlay.OverlayWidgetV3EditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:MixItUp.WPF.Controls"
    xmlns:MaterialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:OverlayControls="clr-namespace:MixItUp.WPF.Controls.Overlay"
    xmlns:Util="clr-namespace:MixItUp.WPF.Util"
    xmlns:Windows="clr-namespace:MixItUp.WPF.Windows"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MixItUp.WPF.Windows.Overlay"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
    xmlns:resx="clr-namespace:MixItUp.Base;assembly=MixItUp.Base"
    Title="{x:Static resx:Resources.OverlayWidgetEditor}"
    Width="800"
    Height="600"
    FontFamily="{DynamicResource NotoSans}"
    Style="{StaticResource MaterialDesignWindow}"
    TextElement.FontSize="{DynamicResource MIU.FontSize.BodyMedium}"
    TextElement.FontWeight="Medium"
    mc:Ignorable="d">
    <Windows:LoadingWindowBase.Resources>
        <Util:LocalizationConverter x:Key="LocalizationConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Windows:LoadingWindowBase.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <MaterialDesign:DialogHost x:Name="MDDialogHost" Identifier="RootDialog" AutomationProperties.AutomationId="OverlayWidgetV3Editor.MDDialogHost" />

        <ScrollViewer Grid.Row="0">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        Grid.Column="0"
                        MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.Name}"
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                        Text="{Binding Name}"
                        AutomationProperties.AutomationId="OverlayWidgetV3Editor.NameTextBox"
                        AutomationProperties.Name="{x:Static resx:Resources.Name}" />

                    <ComboBox
                        Grid.Column="2"
                        MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.DisplayOption}"
                        ItemsSource="{Binding DisplayOptions}"
                        SelectedItem="{Binding SelectedDisplayOption}"
                        Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                        AutomationProperties.AutomationId="OverlayWidgetV3Editor.DisplayOptionComboBox"
                        AutomationProperties.Name="{x:Static resx:Resources.DisplayOption}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource LocalizationConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <ComboBox
                        Grid.Column="4"
                        MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.OverlayEndpoints}"
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding OverlayEndpoints}"
                        SelectedItem="{Binding SelectedOverlayEndpoint}"
                        Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                        Visibility="{Binding IsDisplayOptionOverlayEndpoint, Converter={StaticResource BooleanToVisibilityConverter}}"
                        AutomationProperties.AutomationId="OverlayWidgetV3Editor.OverlayEndpointsComboBox"
                        AutomationProperties.Name="{x:Static resx:Resources.OverlayEndpoints}" />

                    <Controls:IconButton
                        x:Name="OldHTMLButton"
                        Grid.Column="5"
                        Margin="10,0,0,0"
                        Click="OldHTMLButton_Click"
                        Icon="history"
                        ToolTip="{x:Static resx:Resources.OldHTML}"
                        Visibility="{Binding ShowOldCustomHTML, Converter={StaticResource BooleanToVisibilityConverter}}"
                        AutomationProperties.AutomationId="OverlayWidgetV3Editor.OldHTMLButton"
                        AutomationProperties.Name="{x:Static resx:Resources.OldHTML}" />
                </Grid>

                <Border Grid.Row="2" Style="{StaticResource DefaultBorder}">
                    <TabControl
                        SnapsToDevicePixels="True"
                        Style="{StaticResource MaterialDesignFilledTabControl}"
                        TabStripPlacement="Top"
                        AutomationProperties.AutomationId="OverlayWidgetV3Editor.WidgetTabs">
                        <TabItem HorizontalAlignment="Stretch" Header="{x:Static resx:Resources.Details}" AutomationProperties.AutomationId="OverlayWidgetV3Editor.DetailsTab">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <ContentControl
                                    x:Name="InnerContent"
                                    Grid.Row="0"
                                    DataContext="{Binding Item}" />

                                <Grid
                                    Grid.Row="1"
                                    Margin="0,10,0,0"
                                    Visibility="{Binding IsBasicWidget}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox
                                        Grid.Column="0"
                                        Width="150"
                                        MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.RefreshTimeSecs}"
                                        Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                        Text="{Binding RefreshTime}"
                                        Visibility="{Binding IsBasicWidget, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        AutomationProperties.AutomationId="OverlayWidgetV3Editor.RefreshTimeSecsTextBox"
                                        AutomationProperties.Name="{x:Static resx:Resources.RefreshTimeSecs}" />
                                </Grid>
                            </Grid>
                        </TabItem>

                        <TabItem HorizontalContentAlignment="Stretch" Header="{x:Static resx:Resources.Position}" AutomationProperties.AutomationId="OverlayWidgetV3Editor.PositionTab">
                            <OverlayControls:OverlayPositionV3Control
                                x:Name="Position"
                                Margin="10"
                                DataContext="{Binding Position}" />
                        </TabItem>

                        <TabItem Header="{x:Static resx:Resources.Animation}" AutomationProperties.AutomationId="OverlayWidgetV3Editor.AnimationTab">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel
                                    x:Name="AnimationsMayNotWork"
                                    Grid.Row="0"
                                    Orientation="Vertical">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Foreground="Red"
                                        Text="{x:Static resx:Resources.OverlayWarning1}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Foreground="Red"
                                        Text="{x:Static resx:Resources.OverlayWarning2}" />
                                    <TextBlock HorizontalAlignment="Center">
                                        <Hyperlink NavigateUri="https://wiki.mixitup.bot/services/overlay#windows-settings-overlay-animation-issue" RequestNavigate="Hyperlink_RequestNavigate" AutomationProperties.AutomationId="OverlayWidgetV3Editor.OverlayWarning2Link">
                                            <TextBlock Text="{x:Static resx:Resources.OverlayWarning3}" />
                                        </Hyperlink>
                                    </TextBlock>
                                </StackPanel>

                                <ItemsControl Grid.Row="3" ItemsSource="{Binding Animations}" AutomationProperties.AutomationId="OverlayWidgetV3Editor.CustomVariablesList" AutomationProperties.Name="{x:Static resx:Resources.Variables}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <OverlayControls:OverlayAnimationV3Control />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </TabItem>

                        <TabItem Header="{Binding HTMLHeader}" AutomationProperties.AutomationId="OverlayWidgetV3Editor.HtmlTab">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource DefaultBorder}">
                                    <avalonEdit:TextEditor Height="400" Util:AvalonEditBehaviour.Text="{Binding HTML}" Util:AvalonEditCustomHighlighting.Language="HTML" ShowLineNumbers="True" FontFamily="Consolas" Background="{DynamicResource MaterialDesignPaper}" Foreground="{DynamicResource MaterialDesignBody}" AutomationProperties.AutomationId="OverlayWidgetV3Editor.HtmlEditor" AutomationProperties.Name="{x:Static resx:Resources.OverlayHtml}" />
                                </Border>
                                <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10"
                                        Click="PopoutButton_Click"
                                        Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                        ToolTip="{x:Static resx:Resources.PopoutEditor}"
                                        AutomationProperties.AutomationId="OverlayWidgetV3Editor.HtmlPopoutButton"
                                        AutomationProperties.Name="{x:Static resx:Resources.PopoutEditor}">
                                    <Controls:MaterialSymbolIcon IconName="open_in_new" FontSize="{DynamicResource MIU.IconSize.16}" />
                                </Button>
                            </Grid>
                        </TabItem>

                        <TabItem Header="{Binding CSSHeader}" AutomationProperties.AutomationId="OverlayWidgetV3Editor.CssTab">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource DefaultBorder}">
                                    <avalonEdit:TextEditor Height="400" Util:AvalonEditBehaviour.Text="{Binding CSS}" Util:AvalonEditCustomHighlighting.Language="CSS" ShowLineNumbers="True" FontFamily="Consolas" Background="{DynamicResource MaterialDesignPaper}" Foreground="{DynamicResource MaterialDesignBody}" AutomationProperties.AutomationId="OverlayWidgetV3Editor.CssEditor" AutomationProperties.Name="{x:Static resx:Resources.OverlayCss}" />
                                </Border>
                                <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10"
                                        Click="PopoutButton_Click"
                                        Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                        ToolTip="{x:Static resx:Resources.PopoutEditor}"
                                        AutomationProperties.AutomationId="OverlayWidgetV3Editor.CssPopoutButton"
                                        AutomationProperties.Name="{x:Static resx:Resources.PopoutEditor}">
                                    <Controls:MaterialSymbolIcon IconName="open_in_new" FontSize="{DynamicResource MIU.IconSize.16}" />
                                </Button>
                            </Grid>
                        </TabItem>

                        <TabItem Header="{Binding JavascriptHeader}" AutomationProperties.AutomationId="OverlayWidgetV3Editor.JavascriptTab">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource DefaultBorder}">
                                    <avalonEdit:TextEditor Height="400" Util:AvalonEditBehaviour.Text="{Binding Javascript}" Util:AvalonEditCustomHighlighting.Language="JavaScript" ShowLineNumbers="True" FontFamily="Consolas" Background="{DynamicResource MaterialDesignPaper}" Foreground="{DynamicResource MaterialDesignBody}" AutomationProperties.AutomationId="OverlayWidgetV3Editor.JavascriptEditor" AutomationProperties.Name="{x:Static resx:Resources.OverlayJavascript}" />
                                </Border>
                                <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10"
                                        Click="PopoutButton_Click"
                                        Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                        ToolTip="{x:Static resx:Resources.PopoutEditor}"
                                        AutomationProperties.AutomationId="OverlayWidgetV3Editor.JavascriptPopoutButton"
                                        AutomationProperties.Name="{x:Static resx:Resources.PopoutEditor}">
                                    <Controls:MaterialSymbolIcon IconName="open_in_new" FontSize="{DynamicResource MIU.IconSize.16}" />
                                </Button>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Controls:IconButton
                    Grid.Column="0"
                    Command="{Binding SaveCommand}"
                    Icon="save"
                    ToolTip="{x:Static resx:Resources.Save}"
                    AutomationProperties.AutomationId="OverlayWidgetV3Editor.SaveButton"
                    AutomationProperties.Name="{x:Static resx:Resources.Save}" />

                <Controls:IconButton
                    Grid.Column="2"
                    Command="{Binding TestCommand}"
                    Icon="play_arrow"
                    IsEnabled="{Binding IsTestable}"
                    ToolTip="{x:Static resx:Resources.TestCommand}"
                    AutomationProperties.AutomationId="OverlayWidgetV3Editor.TestCommandButton"
                    AutomationProperties.Name="{x:Static resx:Resources.TestCommand}" />

                <Controls:IconButton
                    Grid.Column="4"
                    Command="{Binding ExportCommand}"
                    Icon="output"
                    ToolTip="{x:Static resx:Resources.ExportData}"
                    AutomationProperties.AutomationId="OverlayWidgetV3Editor.ExportDataButton"
                    AutomationProperties.Name="{x:Static resx:Resources.ExportData}" />
            </Grid>

            <Controls:LoadingStatusBar x:Name="StatusBar" Grid.Row="2" />
        </Grid>
    </Grid>
</Windows:LoadingWindowBase>
