    <!-- ===========================================================
         Typography — MD3 Type Scale
         Source: app.css §3 Typography
         Base:   1rem = 16px
         Brand:  BebasNeue  → Display / Headline / Title  (h1–h3)
         Plain:  NotoSans   → Body / Label               (p / label)
         CharacterSpacing is in thousandths of an em (em × 1000).
         =========================================================== -->

    <!-- ── Size tokens ──────────────────────────────────────────────
         Naming: MIU.FontSize.<Tier><Step>, matching the MIU.Brush.* convention
         and the app.css §3 scale step names.

         One token per named style rather than one per distinct value: TitleSmall,
         BodyMedium and LabelLarge all happen to be 14 today, but they are separate
         steps in MD3 and collapsing them would make it impossible to tune one tier
         without dragging the others along.

         These MUST be consumed with DynamicResource everywhere. A StaticResource
         reference resolves once at parse time, so it would keep working, keep
         throwing no exception, and silently ignore any later reassignment.
         ────────────────────────────────────────────────────────────── -->

    <sys:Double x:Key="MIU.FontSize.DisplayLarge">57</sys:Double>
    <sys:Double x:Key="MIU.FontSize.DisplayMedium">45</sys:Double>
    <sys:Double x:Key="MIU.FontSize.DisplaySmall">36</sys:Double>

    <sys:Double x:Key="MIU.FontSize.HeadlineLarge">32</sys:Double>
    <sys:Double x:Key="MIU.FontSize.HeadlineMedium">28</sys:Double>
    <sys:Double x:Key="MIU.FontSize.HeadlineSmall">24</sys:Double>

    <sys:Double x:Key="MIU.FontSize.TitleLarge">22</sys:Double>
    <sys:Double x:Key="MIU.FontSize.TitleMedium">16</sys:Double>
    <sys:Double x:Key="MIU.FontSize.TitleSmall">14</sys:Double>

    <sys:Double x:Key="MIU.FontSize.BodyLarge">16</sys:Double>
    <sys:Double x:Key="MIU.FontSize.BodyMedium">14</sys:Double>
    <sys:Double x:Key="MIU.FontSize.BodySmall">12</sys:Double>

    <sys:Double x:Key="MIU.FontSize.LabelLarge">14</sys:Double>
    <sys:Double x:Key="MIU.FontSize.LabelMedium">12</sys:Double>
    <sys:Double x:Key="MIU.FontSize.LabelSmall">11</sys:Double>

    <!-- ── Icon size tokens ─────────────────────────────────────────
         Deliberately a SEPARATE set from the text scale above: icon sizing is its
         own concern (see MaterialSymbolIcon), so it can be tuned or scaled on its
         own rhythm without dragging text along, and vice versa.

         One token per glyph size actually in use, so every icon can be reached by
         the future scale factor without changing any size today. Snapping the
         outliers (10, 28, 32) onto a shorter scale was rejected: it would visibly
         distort those glyphs and break the pixel-identity guarantee.

         The two 80px glyphs (MusicPlayerControl, CommandEditorWindow) are large
         decorative art, deliberately left as literals so they do NOT scale.

         Consumed via DynamicResource, same rule as the text tokens.
         ────────────────────────────────────────────────────────────── -->

    <sys:Double x:Key="MIU.IconSize.10">10</sys:Double>
    <sys:Double x:Key="MIU.IconSize.11">11</sys:Double>
    <sys:Double x:Key="MIU.IconSize.14">14</sys:Double>
    <sys:Double x:Key="MIU.IconSize.16">16</sys:Double>
    <sys:Double x:Key="MIU.IconSize.18">18</sys:Double>
    <sys:Double x:Key="MIU.IconSize.20">20</sys:Double>
    <sys:Double x:Key="MIU.IconSize.22">22</sys:Double>
    <sys:Double x:Key="MIU.IconSize.24">24</sys:Double>
    <sys:Double x:Key="MIU.IconSize.28">28</sys:Double>
    <sys:Double x:Key="MIU.IconSize.32">32</sys:Double>

    <!-- ── Display ─────────────────────────────────────────────── -->

    <!-- h1.large  57px / 64px lh / Regular / tracking -0.0044em -->
    <Style x:Key="DisplayLarge" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily"                  Value="{DynamicResource BebasNeue}" />
        <Setter Property="FontSize"                    Value="{DynamicResource MIU.FontSize.DisplayLarge}" />
        <Setter Property="FontWeight"                  Value="Normal" />
        <Setter Property="LineHeight"                  Value="64" />
    </Style>

