<UserControl x:Class="MixItUp.WPF.Controls.Requirements.CooldownRequirementControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MixItUp.WPF.Controls.Requirements"
             xmlns:resx="clr-namespace:MixItUp.Base;assembly=MixItUp.Base"
             xmlns:util="clr-namespace:MixItUp.WPF.Util"
             xmlns:Controls="clr-namespace:MixItUp.WPF.Controls"
             xmlns:MaterialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             TextElement.FontWeight="Medium"
             TextElement.FontSize="{DynamicResource MIU.FontSize.BodyMedium}"
             FontFamily="pack://application:,,,/MaterialDesignThemes.Wpf;component/Resources/Roboto/#Roboto"   
             
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>
        <util:LocalizationConverter x:Key="LocalizationConverter"/>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid MinWidth="300" MinHeight="100">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{x:Static resx:Resources.Cooldown}" HorizontalAlignment="Center" TextDecorations="Underline" FontWeight="Bold" />

        <ItemsControl Grid.Row="2" ItemsSource="{Binding Items}" HorizontalAlignment="Center" AutomationProperties.AutomationId="CooldownRequirement.CooldownList" AutomationProperties.Name="{x:Static resx:Resources.Cooldown}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ComboBox Grid.Row="0" Grid.Column="0" ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.Type}" Width="120" Style="{StaticResource MaterialDesignFloatingHintComboBox}" AutomationProperties.AutomationId="CooldownRow.TypeComboBox" AutomationProperties.Name="{x:Static resx:Resources.Type}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource LocalizationConverter}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding Amount}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.Seconds}" Width="70" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="CooldownRow.SecondsTextBox" AutomationProperties.Name="{x:Static resx:Resources.Seconds}" />

                        <Controls:IconButton Grid.Row="0" Grid.Column="4" Command="{Binding DeleteCommand}" IsEnabled="{Binding CanDelete}" HorizontalAlignment="Center" Icon="Delete" ToolTip="{x:Static resx:Resources.Delete}" AutomationProperties.AutomationId="CooldownRow.DeleteButton" AutomationProperties.Name="{x:Static resx:Resources.Delete}" />

                        <ComboBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" ItemsSource="{Binding GroupNames}" Text="{Binding SelectedGroupName}" IsEditable="True" Visibility="{Binding IsGroupSelected, Converter={StaticResource BooleanToVisibilityConverter}}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.GroupName}" Margin="0,10,0,0" Width="200" HorizontalAlignment="Left" AutomationProperties.AutomationId="CooldownRow.GroupNameComboBox" AutomationProperties.Name="{x:Static resx:Resources.GroupName}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Grid.Row="4" Command="{Binding AddItemCommand}" Width="80" Style="{StaticResource MaterialDesignRaisedButton}" Content="{x:Static resx:Resources.Add}" HorizontalAlignment="Center" AutomationProperties.AutomationId="CooldownRequirement.AddButton" />
    </Grid>
</UserControl>
