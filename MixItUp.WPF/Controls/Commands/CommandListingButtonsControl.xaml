<Controls:NotifyPropertyChangedUserControl x:Class="MixItUp.WPF.Controls.Commands.CommandListingButtonsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MixItUp.WPF.Controls.Commands"
             xmlns:resx="clr-namespace:MixItUp.Base;assembly=MixItUp.Base"
             xmlns:Controls="clr-namespace:MixItUp.WPF.Controls"
             xmlns:MaterialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel Orientation="Horizontal" Margin="5,0">

        <Controls:IconButton x:Name="PlayButton" Click="PlayButton_Click" Icon="play_arrow" ToolTip="{x:Static resx:Resources.TestCommand}" AutomationProperties.AutomationId="CommandListingButtons.PlayButton" AutomationProperties.Name="{Binding Name, StringFormat={x:Static resx:Resources.TestCommandFormat}}" />
        <Controls:IconButton x:Name="StopButton" Visibility="Collapsed" Click="StopButton_Click" HorizontalAlignment="Center" Icon="stop" ToolTip="{x:Static resx:Resources.StopCommand}" AutomationProperties.AutomationId="CommandListingButtons.StopButton" AutomationProperties.Name="{Binding Name, StringFormat={x:Static resx:Resources.StopCommandFormat}}" />
        <Controls:IconButton x:Name="CommandListingButtonsEditButton" Click="EditButton_Click" Margin="10,0,0,0" HorizontalAlignment="Center" Icon="rate_review" ToolTip="{x:Static resx:Resources.EditCommand}" AutomationProperties.AutomationId="CommandListingButtons.EditButton" AutomationProperties.Name="{Binding Name, StringFormat={x:Static resx:Resources.EditCommandFormat}}" />
        <Controls:IconButton x:Name="CommandListingButtonsDeleteButton" Click="DeleteButton_Click" Margin="10,0,0,0" HorizontalAlignment="Center" Icon="delete" ToolTip="{x:Static resx:Resources.DeleteCommand}" AutomationProperties.AutomationId="CommandListingButtons.DeleteButton" AutomationProperties.Name="{Binding Name, StringFormat={x:Static resx:Resources.DeleteCommandFormat}}" />

        <ToggleButton x:Name="CommandListingButtonsEnableDisableToggleSwitch" Margin="10,0,0,0" Style="{StaticResource MaterialDesignSwitchToggleButton}" VerticalAlignment="Center" HorizontalAlignment="Center" ToolTip="{x:Static resx:Resources.EnableDisableCommand}" Checked="EnableDisableToggleSwitch_Checked" Unchecked="EnableDisableToggleSwitch_Checked" AutomationProperties.AutomationId="CommandListingButtons.EnableDisableToggle" AutomationProperties.Name="{Binding Name, StringFormat={x:Static resx:Resources.EnableDisableCommandFormat}}" />

    </StackPanel>
</Controls:NotifyPropertyChangedUserControl>