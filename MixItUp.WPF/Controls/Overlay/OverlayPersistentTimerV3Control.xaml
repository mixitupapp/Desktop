<Controls:LoadingControlBase x:Class="MixItUp.WPF.Controls.Overlay.OverlayPersistentTimerV3Control"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MixItUp.WPF.Controls.Overlay"
             xmlns:Util="clr-namespace:MixItUp.WPF.Util"
             xmlns:resx="clr-namespace:MixItUp.Base;assembly=MixItUp.Base"
             xmlns:Controls="clr-namespace:MixItUp.WPF.Controls"
             xmlns:CommandControls="clr-namespace:MixItUp.WPF.Controls.Commands"
             xmlns:OverlayControls="clr-namespace:MixItUp.WPF.Controls.Overlay"
             xmlns:MaterialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Controls:LoadingControlBase.Resources>
        <Util:LocalizationConverter x:Key="LocalizationConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Controls:LoadingControlBase.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="180" />
            </Grid.ColumnDefinitions>

            <TextBox Text="{Binding FontSize}" Grid.Column="0" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.FontSize}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayPersistentTimerV3.FontSizeTextBox" AutomationProperties.Name="{x:Static resx:Resources.FontSize}" />

            <ComboBox Text="{Binding FontName}" Grid.Column="2" ItemsSource="{Binding Fonts}" IsEditable="True" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.FontName}" Style="{StaticResource MaterialDesignFloatingHintComboBox}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.AutomationId="OverlayPersistentTimerV3.FontNameComboBox" AutomationProperties.Name="{x:Static resx:Resources.FontName}">
                <ComboBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ComboBox.ItemsPanel>
            </ComboBox>

            <Controls:ColorPickerTextBox ColorText="{Binding FontColor}" Grid.Column="4" HintText="{x:Static resx:Resources.FontColor}" AutomationProperties.AutomationId="OverlayPersistentTimerV3.FontColorColorPicker" AutomationProperties.Name="{x:Static resx:Resources.FontColor}" />

            <Controls:ColorPickerTextBox ColorText="{Binding ShadowColor}" Grid.Column="6" HintText="{x:Static resx:Resources.ShadowColor}" AutomationProperties.AutomationId="OverlayPersistentTimerV3.ShadowColorColorPicker" AutomationProperties.Name="{x:Static resx:Resources.ShadowColor}" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0" SelectionMode="Extended" Style="{StaticResource MaterialDesignToolToggleFlatListBox}" MaterialDesign:ListBoxAssist.CanUserToggleSelectedItem="True" AutomationProperties.AutomationId="OverlayPersistentTimerV3.FontStyleList" AutomationProperties.Name="{x:Static resx:Resources.FontStyle}">
                <ListBoxItem IsSelected="{Binding Bold}" AutomationProperties.AutomationId="OverlayPersistentTimerV3.BoldItem" AutomationProperties.Name="{x:Static resx:Resources.Bold}">
                    <Controls:MaterialSymbolIcon IconName="format_bold" FontSize="{DynamicResource MIU.IconSize.16}" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" />
                </ListBoxItem>
                <ListBoxItem IsSelected="{Binding Italics}" AutomationProperties.AutomationId="OverlayPersistentTimerV3.ItalicsItem" AutomationProperties.Name="{x:Static resx:Resources.Italics}">
                    <Controls:MaterialSymbolIcon IconName="format_italic" FontSize="{DynamicResource MIU.IconSize.16}" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" />
                </ListBoxItem>
                <ListBoxItem IsSelected="{Binding Underline}" AutomationProperties.AutomationId="OverlayPersistentTimerV3.UnderlineItem" AutomationProperties.Name="{x:Static resx:Resources.Underline}">
                    <Controls:MaterialSymbolIcon IconName="format_underlined" FontSize="{DynamicResource MIU.IconSize.16}" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" />
                </ListBoxItem>
            </ListBox>

            <ListBox Grid.Column="2" SelectionMode="Single" Style="{StaticResource MaterialDesignToolToggleFlatListBox}" AutomationProperties.AutomationId="OverlayPersistentTimerV3.TextAlignmentList" AutomationProperties.Name="{x:Static resx:Resources.TextAlignment}">
                <ListBoxItem IsSelected="{Binding LeftAlignment}" AutomationProperties.AutomationId="OverlayPersistentTimerV3.LeftAlignmentItem" AutomationProperties.Name="{x:Static resx:Resources.LeftAlignment}">
                    <Controls:MaterialSymbolIcon IconName="format_align_left" FontSize="{DynamicResource MIU.IconSize.16}" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" />
                </ListBoxItem>
                <ListBoxItem IsSelected="{Binding CenterAlignment}" AutomationProperties.AutomationId="OverlayPersistentTimerV3.CenterAlignmentItem" AutomationProperties.Name="{x:Static resx:Resources.CenterAlignment}">
                    <Controls:MaterialSymbolIcon IconName="format_align_center" FontSize="{DynamicResource MIU.IconSize.16}" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" />
                </ListBoxItem>
                <ListBoxItem IsSelected="{Binding RightAlignment}" AutomationProperties.AutomationId="OverlayPersistentTimerV3.RightAlignmentItem" AutomationProperties.Name="{x:Static resx:Resources.RightAlignment}">
                    <Controls:MaterialSymbolIcon IconName="format_align_right" FontSize="{DynamicResource MIU.IconSize.16}" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" />
                </ListBoxItem>
                <ListBoxItem IsSelected="{Binding JustifyAlignment}" AutomationProperties.AutomationId="OverlayPersistentTimerV3.JustifyAlignmentItem" AutomationProperties.Name="{x:Static resx:Resources.JustifyAlignment}">
                    <Controls:MaterialSymbolIcon IconName="format_align_justify" FontSize="{DynamicResource MIU.IconSize.16}" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" />
                </ListBoxItem>
            </ListBox>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="20" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding Source={x:Static resx:Resources.InitialAmount}, StringFormat={x:Static resx:Resources.ColumnHeaderFormat}}" VerticalAlignment="Center" Margin="0,10,0,0" />
            <TextBox Text="{Binding InitialAmount}" Grid.Column="2" Width="80" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.Seconds}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" VerticalAlignment="Center" AutomationProperties.AutomationId="OverlayPersistentTimerV3.InitialAmountTextBox" AutomationProperties.Name="{x:Static resx:Resources.Seconds}" />

            <TextBox Grid.Column="4" Text="{Binding DisplayFormat}" Width="150" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.DisplayFormat}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayPersistentTimerV3.DisplayFormatTextBox" AutomationProperties.Name="{x:Static resx:Resources.DisplayFormat}" />

            <TextBlock Grid.Column="6" Text="{Binding Source={x:Static resx:Resources.MaxAmount}, StringFormat={x:Static resx:Resources.ColumnHeaderFormat}}" VerticalAlignment="Center" Margin="0,10,0,0" />
            <TextBox Text="{Binding MaxAmount}" Grid.Column="8" Width="80" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.Seconds}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" VerticalAlignment="Center" AutomationProperties.AutomationId="OverlayPersistentTimerV3.MaxAmountTextBox" AutomationProperties.Name="{x:Static resx:Resources.Seconds}" />
        </Grid>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding Source={x:Static resx:Resources.DisableOnCompletion}, StringFormat={x:Static resx:Resources.ColumnHeaderFormat}}" />
            <CheckBox Grid.Column="1" IsChecked="{Binding DisableOnCompletion}" VerticalAlignment="Center" Margin="5,0,0,0" AutomationProperties.AutomationId="OverlayPersistentTimerV3.DisableOnCompletionCheckBox" AutomationProperties.Name="{x:Static resx:Resources.DisableOnCompletion}" />

            <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{Binding Source={x:Static resx:Resources.ResetOnEnable}, StringFormat={x:Static resx:Resources.ColumnHeaderFormat}}" />
            <CheckBox Grid.Column="4" IsChecked="{Binding ResetOnEnable}" VerticalAlignment="Center" Margin="5,0,0,0" AutomationProperties.AutomationId="OverlayPersistentTimerV3.ResetOnEnableCheckBox" AutomationProperties.Name="{x:Static resx:Resources.ResetOnEnable}" />

            <TextBlock Grid.Column="6" VerticalAlignment="Center" Text="{Binding Source={x:Static resx:Resources.AllowAdjustmentWhilePaused}, StringFormat={x:Static resx:Resources.ColumnHeaderFormat}}" />
            <CheckBox Grid.Column="7" IsChecked="{Binding AllowAdjustmentWhilePaused}" VerticalAlignment="Center" Margin="5,0,0,0" AutomationProperties.AutomationId="OverlayPersistentTimerV3.AllowAdjustmentWhilePausedCheckBox" AutomationProperties.Name="{x:Static resx:Resources.AllowAdjustmentWhilePaused}" />
        </Grid>

        <Grid Grid.Row="8" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="50" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <CommandControls:CustomCommandListingControl Grid.Column="0" DataContext="{Binding TimerAdjustedCommand}" Header="{x:Static resx:Resources.TimerAdjusted}" />

            <CommandControls:CustomCommandListingControl Grid.Column="2" DataContext="{Binding TimerCompletedCommand}" Header="{x:Static resx:Resources.TimerCompleted}" />
        </Grid>

        <Grid Grid.Row="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <GroupBox Header="{x:Static resx:Resources.Follows}" Grid.Row="0" Grid.Column="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox Grid.Column="0" Text="{Binding FollowAmount}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.TimeAmount}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayPersistentTimerV3.FollowsTimeAmountTextBox" AutomationProperties.Name="{x:Static resx:Resources.TimeAmount}" />
                </Grid>
            </GroupBox>

            <GroupBox Header="{x:Static resx:Resources.Raids}" Grid.Row="0" Grid.Column="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" Text="{Binding RaidAmount}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.TimeAmount}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayPersistentTimerV3.RaidsTimeAmountTextBox" AutomationProperties.Name="{x:Static resx:Resources.TimeAmount}" />

                        <TextBox Grid.Column="2" Text="{Binding RaidPerViewAmount}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.TimeMultiplier}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayPersistentTimerV3.RaidsTimeMultiplierTextBox" AutomationProperties.Name="{x:Static resx:Resources.TimeMultiplier}" />
                    </Grid>

                    <TextBlock Grid.Row="2" Text="{Binding RaidEquation}" />
                </Grid>
            </GroupBox>

            <GroupBox Header="{x:Static resx:Resources.TwitchSubscriptions}" Grid.Row="2" Grid.ColumnSpan="3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding Source={x:Static resx:Resources.Tier1}, StringFormat={x:Static resx:Resources.ColumnHeaderFormat}}" VerticalAlignment="Bottom" Margin="0,0,10,5" />
                    <TextBox Grid.Column="1" Text="{Binding TwitchSubscriptionTier1Amount}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.TimeAmount}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayPersistentTimerV3.TwitchSubscriptionTier1AmountTextBox" AutomationProperties.Name="{x:Static resx:Resources.TimeAmount}" />

                    <TextBlock Grid.Column="2" Text="{Binding Source={x:Static resx:Resources.Tier2}, StringFormat={x:Static resx:Resources.ColumnHeaderFormat}}" VerticalAlignment="Bottom" Margin="10,0,10,5" />
                    <TextBox Grid.Column="3" Text="{Binding TwitchSubscriptionTier2Amount}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.TimeAmount}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayPersistentTimerV3.TwitchSubscriptionTier2AmountTextBox" AutomationProperties.Name="{x:Static resx:Resources.TimeAmount}" />

                    <TextBlock Grid.Column="4" Text="{Binding Source={x:Static resx:Resources.Tier3}, StringFormat={x:Static resx:Resources.ColumnHeaderFormat}}" VerticalAlignment="Bottom" Margin="10,0,10,5" />
                    <TextBox Grid.Column="5" Text="{Binding TwitchSubscriptionTier3Amount}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.TimeAmount}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayPersistentTimerV3.TwitchSubscriptionTier3AmountTextBox" AutomationProperties.Name="{x:Static resx:Resources.TimeAmount}" />
                </Grid>
            </GroupBox>

            <GroupBox Header="{x:Static resx:Resources.YouTubeMemberships}" Grid.Row="4" Grid.ColumnSpan="3">
                <ItemsControl ItemsSource="{Binding YouTubeMemberships}" AutomationProperties.AutomationId="OverlayPersistentTimerV3.EventTypesList" AutomationProperties.Name="{x:Static resx:Resources.EventTypes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="10,0,10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding Name, StringFormat={x:Static resx:Resources.ColumnHeaderFormat}}" VerticalAlignment="Bottom" Margin="0,0,5,0" />
                                <TextBox Grid.Column="2" Text="{Binding Amount}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.TimeAmount}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="EventType.TimeAmountTextBox" AutomationProperties.Name="{x:Static resx:Resources.TimeAmount}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </GroupBox>

            <GroupBox Header="{x:Static resx:Resources.KickSubscriptions}" Grid.Row="6" Grid.ColumnSpan="3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding Source={x:Static resx:Resources.Tier1}, StringFormat={x:Static resx:Resources.ColumnHeaderFormat}}" VerticalAlignment="Bottom" Margin="0,0,10,5" />
                    <TextBox Grid.Column="1" Text="{Binding KickSubscriptionAmount}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.TimeAmount}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayPersistentTimerV3.KickSubscriptionsTimeAmountTextBox" AutomationProperties.Name="{x:Static resx:Resources.TimeAmount}" />
                </Grid>
            </GroupBox>

            <GroupBox Header="{x:Static resx:Resources.VeloraSubscriptions}" Grid.Row="8" Grid.ColumnSpan="3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding Source={x:Static resx:Resources.Tier1}, StringFormat={x:Static resx:Resources.ColumnHeaderFormat}}" VerticalAlignment="Bottom" Margin="0,0,10,5" />
                    <TextBox Grid.Column="1" Text="{Binding VeloraSubscriptionAmount}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.TimeAmount}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayPersistentTimerV3.VeloraSubscriptionsTimeAmountTextBox" AutomationProperties.Name="{x:Static resx:Resources.TimeAmount}" />
                </Grid>
            </GroupBox>

            <GroupBox Header="{x:Static resx:Resources.TwitchBits}" Grid.Row="10" Grid.Column="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox Grid.Row="0" Text="{Binding TwitchBitsAmount}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.TimeMultiplier}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayPersistentTimerV3.TwitchBitsTimeMultiplierTextBox" AutomationProperties.Name="{x:Static resx:Resources.TimeMultiplier}" />

                    <TextBlock Grid.Row="2" Text="{Binding TwitchBitsEquation}" />
                </Grid>
            </GroupBox>

            <GroupBox Header="{x:Static resx:Resources.YouTubeSuperChat}" Grid.Row="10" Grid.Column="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox Grid.Row="0" Text="{Binding YouTubeSuperChatAmount}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.TimeMultiplier}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayPersistentTimerV3.YouTubeSuperChatTimeMultiplierTextBox" AutomationProperties.Name="{x:Static resx:Resources.TimeMultiplier}" />

                    <TextBlock Grid.Row="2" Text="{Binding YouTubeSuperChatEquation}" />
                </Grid>
            </GroupBox>

            <GroupBox Header="{x:Static resx:Resources.KickKicks}" Grid.Row="12" Grid.Column="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox Grid.Row="0" Text="{Binding KickKicksAmount}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.TimeMultiplier}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayPersistentTimerV3.KickKicksTimeMultiplierTextBox" AutomationProperties.Name="{x:Static resx:Resources.TimeMultiplier}" />

                    <TextBlock Grid.Row="2" Text="{Binding KickKicksEquation}" />
                </Grid>
            </GroupBox>

            <GroupBox Header="{x:Static resx:Resources.VeloraCheered}" Grid.Row="14" Grid.Column="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox Grid.Row="0" Text="{Binding VeloraCheeredAmount}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.TimeMultiplier}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayPersistentTimerV3.VeloraCheeredTimeMultiplierTextBox" AutomationProperties.Name="{x:Static resx:Resources.TimeMultiplier}" />

                    <TextBlock Grid.Row="2" Text="{Binding VeloraCheeredEquation}" />
                </Grid>
            </GroupBox>

            <GroupBox Header="{x:Static resx:Resources.Donations}" Grid.Row="12" Grid.Column="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox Grid.Row="0" Text="{Binding DonationAmount}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.TimeMultiplier}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayPersistentTimerV3.DonationsTimeMultiplierTextBox" AutomationProperties.Name="{x:Static resx:Resources.TimeMultiplier}" />

                    <TextBlock Grid.Row="2" Text="{Binding DonationEquation}" />
                </Grid>
            </GroupBox>

            <GroupBox Header="{x:Static resx:Resources.VPZoneSubscriptions}" Grid.Row="16" Grid.ColumnSpan="3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding Source={x:Static resx:Resources.Tier1}, StringFormat={x:Static resx:Resources.ColumnHeaderFormat}}" VerticalAlignment="Bottom" Margin="0,0,10,5" />
                    <TextBox Grid.Column="1" Text="{Binding VPZoneSubscriptionAmount}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.TimeAmount}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayPersistentTimerV3.VPZoneSubscriptionsTextBox" AutomationProperties.Name="{x:Static resx:Resources.TimeAmount}" />
                </Grid>
            </GroupBox>

            <GroupBox Header="{x:Static resx:Resources.VPZoneCheered}" Grid.Row="18" Grid.Column="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox Grid.Row="0" Text="{Binding VPZoneCheeredAmount}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.TimeMultiplier}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayPersistentTimerV3.VPZoneCheeredTextBox" AutomationProperties.Name="{x:Static resx:Resources.TimeMultiplier}" />

                    <TextBlock Grid.Row="2" Text="{Binding VPZoneCheeredEquation}" />
                </Grid>
            </GroupBox>

        </Grid>
    </Grid>
</Controls:LoadingControlBase>

