<Controls:LoadingControlBase x:Class="MixItUp.WPF.Controls.Overlay.OverlayEventListV3Control"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MixItUp.WPF.Controls.Overlay"
             xmlns:Util="clr-namespace:MixItUp.WPF.Util"
             xmlns:resx="clr-namespace:MixItUp.Base;assembly=MixItUp.Base"
             xmlns:Controls="clr-namespace:MixItUp.WPF.Controls"
             xmlns:CommandControls="clr-namespace:MixItUp.WPF.Controls.Commands"
             xmlns:OverlayControls="clr-namespace:MixItUp.WPF.Controls.Overlay"
             xmlns:MaterialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Controls:LoadingControlBase.Resources>
        <Util:LocalizationConverter x:Key="LocalizationConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Controls:LoadingControlBase.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GroupBox Header="{x:Static resx:Resources.Username}" Grid.Row="0">
            <Grid Margin="10" DataContext="{Binding Header}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Text="{Binding FontSize}" Grid.Column="0" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.FontSize}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayEventListV3.UsernameFontSizeTextBox" AutomationProperties.Name="{x:Static resx:Resources.FontSize}" />

                <ComboBox Text="{Binding FontName}" Grid.Column="2" ItemsSource="{Binding Fonts}" IsEditable="True" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.FontName}" Style="{StaticResource MaterialDesignFloatingHintComboBox}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.AutomationId="OverlayEventListV3.UsernameFontNameComboBox" AutomationProperties.Name="{x:Static resx:Resources.FontName}">
                    <ComboBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ComboBox.ItemsPanel>
                </ComboBox>

                <Controls:ColorPickerTextBox ColorText="{Binding FontColor}" Grid.Column="4" HintText="{x:Static resx:Resources.FontColor}" AutomationProperties.AutomationId="OverlayEventListV3.UsernameFontColorColorPicker" AutomationProperties.Name="{x:Static resx:Resources.FontColor}" />

                <Controls:ColorPickerTextBox ColorText="{Binding ShadowColor}" Grid.Column="6" HintText="{x:Static resx:Resources.ShadowColor}" AutomationProperties.AutomationId="OverlayEventListV3.UsernameShadowColorColorPicker" AutomationProperties.Name="{x:Static resx:Resources.ShadowColor}" />

                <ListBox Grid.Column="8" SelectionMode="Extended" Style="{StaticResource MaterialDesignToolToggleFlatListBox}" MaterialDesign:ListBoxAssist.CanUserToggleSelectedItem="True" AutomationProperties.AutomationId="OverlayEventListV3.UsernameFontStyleList" AutomationProperties.Name="{x:Static resx:Resources.FontStyle}">
                    <ListBoxItem IsSelected="{Binding Bold}" AutomationProperties.AutomationId="OverlayEventListV3.UsernameBoldItem" AutomationProperties.Name="{x:Static resx:Resources.Bold}">
                        <Controls:MaterialSymbolIcon IconName="format_bold" FontSize="{DynamicResource MIU.IconSize.16}" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" />
                    </ListBoxItem>
                    <ListBoxItem IsSelected="{Binding Italics}" AutomationProperties.AutomationId="OverlayEventListV3.UsernameItalicsItem" AutomationProperties.Name="{x:Static resx:Resources.Italics}">
                        <Controls:MaterialSymbolIcon IconName="format_italic" FontSize="{DynamicResource MIU.IconSize.16}" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" />
                    </ListBoxItem>
                    <ListBoxItem IsSelected="{Binding Underline}" AutomationProperties.AutomationId="OverlayEventListV3.UsernameUnderlineItem" AutomationProperties.Name="{x:Static resx:Resources.Underline}">
                        <Controls:MaterialSymbolIcon IconName="format_underlined" FontSize="{DynamicResource MIU.IconSize.16}" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" />
                    </ListBoxItem>
                </ListBox>
            </Grid>
        </GroupBox>

        <GroupBox Header="{x:Static resx:Resources.Details}" Grid.Row="2">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Text="{Binding FontSize}" Grid.Column="0" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.FontSize}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayEventListV3.DetailsFontSizeTextBox" AutomationProperties.Name="{x:Static resx:Resources.FontSize}" />

                <ComboBox Text="{Binding FontName}" Grid.Column="2" ItemsSource="{Binding Fonts}" IsEditable="True" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.FontName}" Style="{StaticResource MaterialDesignFloatingHintComboBox}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.AutomationId="OverlayEventListV3.DetailsFontNameComboBox" AutomationProperties.Name="{x:Static resx:Resources.FontName}">
                    <ComboBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ComboBox.ItemsPanel>
                </ComboBox>

                <Controls:ColorPickerTextBox ColorText="{Binding FontColor}" Grid.Column="4" HintText="{x:Static resx:Resources.FontColor}" AutomationProperties.AutomationId="OverlayEventListV3.DetailsFontColorColorPicker" AutomationProperties.Name="{x:Static resx:Resources.FontColor}" />

                <Controls:ColorPickerTextBox ColorText="{Binding ShadowColor}" Grid.Column="6" HintText="{x:Static resx:Resources.ShadowColor}" AutomationProperties.AutomationId="OverlayEventListV3.DetailsShadowColorColorPicker" AutomationProperties.Name="{x:Static resx:Resources.ShadowColor}" />

                <ListBox Grid.Column="8" SelectionMode="Extended" Style="{StaticResource MaterialDesignToolToggleFlatListBox}" MaterialDesign:ListBoxAssist.CanUserToggleSelectedItem="True" AutomationProperties.AutomationId="OverlayEventListV3.DetailsFontStyleList" AutomationProperties.Name="{x:Static resx:Resources.FontStyle}">
                    <ListBoxItem IsSelected="{Binding Bold}" AutomationProperties.AutomationId="OverlayEventListV3.DetailsBoldItem" AutomationProperties.Name="{x:Static resx:Resources.Bold}">
                        <Controls:MaterialSymbolIcon IconName="format_bold" FontSize="{DynamicResource MIU.IconSize.16}" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" />
                    </ListBoxItem>
                    <ListBoxItem IsSelected="{Binding Italics}" AutomationProperties.AutomationId="OverlayEventListV3.DetailsItalicsItem" AutomationProperties.Name="{x:Static resx:Resources.Italics}">
                        <Controls:MaterialSymbolIcon IconName="format_italic" FontSize="{DynamicResource MIU.IconSize.16}" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" />
                    </ListBoxItem>
                    <ListBoxItem IsSelected="{Binding Underline}" AutomationProperties.AutomationId="OverlayEventListV3.DetailsUnderlineItem" AutomationProperties.Name="{x:Static resx:Resources.Underline}">
                        <Controls:MaterialSymbolIcon IconName="format_underlined" FontSize="{DynamicResource MIU.IconSize.16}" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" />
                    </ListBoxItem>
                </ListBox>
            </Grid>
        </GroupBox>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Controls:ColorPickerTextBox Grid.Column="0" ColorText="{Binding BorderColor}" HintText="{x:Static resx:Resources.BorderColor}" AutomationProperties.AutomationId="OverlayEventListV3.BorderColorColorPicker" AutomationProperties.Name="{x:Static resx:Resources.BorderColor}" />

            <Controls:ColorPickerTextBox Grid.Column="2" ColorText="{Binding BackgroundColor}" HintText="{x:Static resx:Resources.BackgroundColor}" AutomationProperties.AutomationId="OverlayEventListV3.BackgroundColorColorPicker" AutomationProperties.Name="{x:Static resx:Resources.BackgroundColor}" />

            <TextBox Grid.Column="4" Text="{Binding Width}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.ItemWidth}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayEventListV3.ItemWidthTextBox" AutomationProperties.Name="{x:Static resx:Resources.ItemWidth}" />

            <TextBox Grid.Column="6" Text="{Binding Height}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.ItemHeight}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayEventListV3.ItemHeightTextBox" AutomationProperties.Name="{x:Static resx:Resources.ItemHeight}" />

            <TextBox Grid.Column="8" Text="{Binding TotalToShow}" Width="150" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.TotalToShow}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayEventListV3.TotalToShowTextBox" AutomationProperties.Name="{x:Static resx:Resources.TotalToShow}" />

            <TextBlock Grid.Column="10" VerticalAlignment="Center" Text="{Binding Source={x:Static resx:Resources.AddToTop}, StringFormat={x:Static resx:Resources.ColumnHeaderFormat}}" />
            <CheckBox Grid.Column="11" IsChecked="{Binding AddToTop}" VerticalAlignment="Center" Margin="5,0,0,0" AutomationProperties.AutomationId="OverlayEventListV3.AddToTopCheckBox" AutomationProperties.Name="{x:Static resx:Resources.AddToTop}" />
        </Grid>

        <GroupBox Header="{x:Static resx:Resources.Events}" Grid.Row="6">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="{Binding Source={x:Static resx:Resources.Follows}, StringFormat={x:Static resx:Resources.ColumnHeaderFormat}}" />
                <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding Follows}" VerticalAlignment="Center" Margin="5,0,0,0" AutomationProperties.AutomationId="OverlayEventListV3.FollowsCheckBox" AutomationProperties.Name="{x:Static resx:Resources.Follows}" />
                <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding FollowsDetailsTemplate}" IsEnabled="{Binding Follows}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.ItemTemplate}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayEventListV3.FollowsDetailsTemplateTextBox" AutomationProperties.Name="{x:Static resx:Resources.ItemTemplate}" />
                
                
                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="{Binding Source={x:Static resx:Resources.Raids}, StringFormat={x:Static resx:Resources.ColumnHeaderFormat}}" />
                <CheckBox Grid.Row="2" Grid.Column="1" IsChecked="{Binding Raids}" VerticalAlignment="Center" Margin="5,0,0,0" AutomationProperties.AutomationId="OverlayEventListV3.RaidsCheckBox" AutomationProperties.Name="{x:Static resx:Resources.Raids}" />
                <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding RaidsDetailsTemplate}" IsEnabled="{Binding Raids}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.ItemTemplate}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayEventListV3.RaidsDetailsTemplateTextBox" AutomationProperties.Name="{x:Static resx:Resources.ItemTemplate}" />

                
                <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="{Binding Source={x:Static resx:Resources.TwitchSubscriptions}, StringFormat={x:Static resx:Resources.ColumnHeaderFormat}}" />
                <CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding TwitchSubscriptions}" VerticalAlignment="Center" Margin="5,0,0,0" AutomationProperties.AutomationId="OverlayEventListV3.TwitchSubscriptionsCheckBox" AutomationProperties.Name="{x:Static resx:Resources.TwitchSubscriptions}" />
                <Grid Grid.Row="4" Grid.Column="3" IsEnabled="{Binding TwitchSubscriptions}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox Grid.Row="0" Text="{Binding TwitchSubscriptionsDetailsTemplate}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.ItemTemplate}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayEventListV3.TwitchSubscriptionsDetailsTemplateTextBox" AutomationProperties.Name="{x:Static resx:Resources.ItemTemplate}" />
                    <TextBox Grid.Row="1" Text="{Binding TwitchResubscriptionsDetailsTemplate}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.ItemTemplate}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayEventListV3.TwitchResubscriptionsDetailsTemplateTextBox" AutomationProperties.Name="{x:Static resx:Resources.ItemTemplate}" />
                    <TextBox Grid.Row="2" Text="{Binding TwitchGiftedSubscriptionsDetailsTemplate}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.ItemTemplate}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayEventListV3.TwitchGiftedSubscriptionsDetailsTemplateTextBox" AutomationProperties.Name="{x:Static resx:Resources.ItemTemplate}" />
                    <TextBox Grid.Row="3" Text="{Binding TwitchMassGiftedSubscriptionsDetailsTemplate}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.ItemTemplate}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayEventListV3.TwitchMassGiftedSubscriptionsDetailsTemplateTextBox" AutomationProperties.Name="{x:Static resx:Resources.ItemTemplate}" />
                </Grid>

                <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Text="{Binding Source={x:Static resx:Resources.TwitchBits}, StringFormat={x:Static resx:Resources.ColumnHeaderFormat}}" />
                <CheckBox Grid.Row="6" Grid.Column="1" IsChecked="{Binding TwitchBits}" VerticalAlignment="Center" Margin="5,0,0,0" AutomationProperties.AutomationId="OverlayEventListV3.TwitchBitsCheckBox" AutomationProperties.Name="{x:Static resx:Resources.TwitchBits}" />
                <TextBox Grid.Row="6" Grid.Column="3" Text="{Binding TwitchBitsDetailsTemplate}" IsEnabled="{Binding TwitchBits}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.ItemTemplate}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayEventListV3.TwitchBitsDetailsTemplateTextBox" AutomationProperties.Name="{x:Static resx:Resources.ItemTemplate}" />


                <TextBlock Grid.Row="8" Grid.Column="0" VerticalAlignment="Center" Text="{Binding Source={x:Static resx:Resources.YouTubeMemberships}, StringFormat={x:Static resx:Resources.ColumnHeaderFormat}}" />
                <CheckBox Grid.Row="8" Grid.Column="1" IsChecked="{Binding YouTubeMemberships}" VerticalAlignment="Center" Margin="5,0,0,0" AutomationProperties.AutomationId="OverlayEventListV3.YouTubeMembershipsCheckBox" AutomationProperties.Name="{x:Static resx:Resources.YouTubeMemberships}" />
                <Grid Grid.Row="8" Grid.Column="3" IsEnabled="{Binding YouTubeMemberships}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox Grid.Row="0" Text="{Binding YouTubeMembershipsDetailsTemplate}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.ItemTemplate}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayEventListV3.YouTubeMembershipsDetailsTemplateTextBox" AutomationProperties.Name="{x:Static resx:Resources.ItemTemplate}" />
                    <TextBox Grid.Row="1" Text="{Binding YouTubeRenewedMembershipsDetailsTemplate}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.ItemTemplate}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayEventListV3.YouTubeRenewedMembershipsDetailsTemplateTextBox" AutomationProperties.Name="{x:Static resx:Resources.ItemTemplate}" />
                    <TextBox Grid.Row="2" Text="{Binding YouTubeGiftedMembershipsDetailsTemplate}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.ItemTemplate}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayEventListV3.YouTubeGiftedMembershipsDetailsTemplateTextBox" AutomationProperties.Name="{x:Static resx:Resources.ItemTemplate}" />
                    <TextBox Grid.Row="3" Text="{Binding YouTubeMassGiftedMembershipsDetailsTemplate}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.ItemTemplate}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayEventListV3.YouTubeMassGiftedMembershipsDetailsTemplateTextBox" AutomationProperties.Name="{x:Static resx:Resources.ItemTemplate}" />
                </Grid>
                
                
                <TextBlock Grid.Row="10" Grid.Column="0" VerticalAlignment="Center" Text="{Binding Source={x:Static resx:Resources.YouTubeSuperChats}, StringFormat={x:Static resx:Resources.ColumnHeaderFormat}}" />
                <CheckBox Grid.Row="10" Grid.Column="1" IsChecked="{Binding YouTubeSuperChats}" VerticalAlignment="Center" Margin="5,0,0,0" AutomationProperties.AutomationId="OverlayEventListV3.YouTubeSuperChatsCheckBox" AutomationProperties.Name="{x:Static resx:Resources.YouTubeSuperChats}" />
                <TextBox Grid.Row="10" Grid.Column="3" Text="{Binding YouTubeSuperChatsDetailsTemplate}" IsEnabled="{Binding YouTubeSuperChats}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.ItemTemplate}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayEventListV3.YouTubeSuperChatsDetailsTemplateTextBox" AutomationProperties.Name="{x:Static resx:Resources.ItemTemplate}" />

                <TextBlock Grid.Row="12" Grid.Column="0" VerticalAlignment="Center" Text="{Binding Source={x:Static resx:Resources.KickSubscriptions}, StringFormat={x:Static resx:Resources.ColumnHeaderFormat}}" />
                <CheckBox Grid.Row="12" Grid.Column="1" IsChecked="{Binding KickSubscriptions}" VerticalAlignment="Center" Margin="5,0,0,0" AutomationProperties.AutomationId="OverlayEventListV3.KickSubscriptionsCheckBox" AutomationProperties.Name="{x:Static resx:Resources.KickSubscriptions}" />
                <Grid Grid.Row="12" Grid.Column="3" IsEnabled="{Binding KickSubscriptions}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox Grid.Row="0" Text="{Binding KickSubscriptionsDetailsTemplate}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.ItemTemplate}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayEventListV3.KickSubscriptionsDetailsTemplateTextBox" AutomationProperties.Name="{x:Static resx:Resources.ItemTemplate}" />
                    <TextBox Grid.Row="1" Text="{Binding KickResubscriptionsDetailsTemplate}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.ItemTemplate}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayEventListV3.KickResubscriptionsDetailsTemplateTextBox" AutomationProperties.Name="{x:Static resx:Resources.ItemTemplate}" />
                    <TextBox Grid.Row="2" Text="{Binding KickGiftedSubscriptionsDetailsTemplate}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.ItemTemplate}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayEventListV3.KickGiftedSubscriptionsDetailsTemplateTextBox" AutomationProperties.Name="{x:Static resx:Resources.ItemTemplate}" />
                    <TextBox Grid.Row="3" Text="{Binding KickMassGiftedSubscriptionsDetailsTemplate}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.ItemTemplate}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayEventListV3.KickMassGiftedSubscriptionsDetailsTemplateTextBox" AutomationProperties.Name="{x:Static resx:Resources.ItemTemplate}" />
                </Grid>

                <TextBlock Grid.Row="14" Grid.Column="0" VerticalAlignment="Center" Text="{Binding Source={x:Static resx:Resources.KickKicks}, StringFormat={x:Static resx:Resources.ColumnHeaderFormat}}" />
                <CheckBox Grid.Row="14" Grid.Column="1" IsChecked="{Binding KickKicks}" VerticalAlignment="Center" Margin="5,0,0,0" AutomationProperties.AutomationId="OverlayEventListV3.KickKicksCheckBox" AutomationProperties.Name="{x:Static resx:Resources.KickKicks}" />
                <TextBox Grid.Row="14" Grid.Column="3" Text="{Binding KickKicksDetailsTemplate}" IsEnabled="{Binding KickKicks}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.ItemTemplate}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayEventListV3.KickKicksDetailsTemplateTextBox" AutomationProperties.Name="{x:Static resx:Resources.ItemTemplate}" />

                <TextBlock Grid.Row="16" Grid.Column="0" VerticalAlignment="Center" Text="{Binding Source={x:Static resx:Resources.VeloraSubscriptions}, StringFormat={x:Static resx:Resources.ColumnHeaderFormat}}" />
                <CheckBox Grid.Row="16" Grid.Column="1" IsChecked="{Binding VeloraSubscriptions}" VerticalAlignment="Center" Margin="5,0,0,0" AutomationProperties.AutomationId="OverlayEventListV3.VeloraSubscriptionsCheckBox" AutomationProperties.Name="{x:Static resx:Resources.VeloraSubscriptions}" />
                <Grid Grid.Row="16" Grid.Column="3" IsEnabled="{Binding VeloraSubscriptions}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox Grid.Row="0" Text="{Binding VeloraSubscriptionsDetailsTemplate}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.ItemTemplate}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayEventListV3.VeloraSubscriptionsDetailsTemplateTextBox" AutomationProperties.Name="{x:Static resx:Resources.ItemTemplate}" />
                    <TextBox Grid.Row="1" Text="{Binding VeloraResubscriptionsDetailsTemplate}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.ItemTemplate}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayEventListV3.VeloraResubscriptionsDetailsTemplateTextBox" AutomationProperties.Name="{x:Static resx:Resources.ItemTemplate}" />
                    <TextBox Grid.Row="2" Text="{Binding VeloraGiftedSubscriptionsDetailsTemplate}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.ItemTemplate}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayEventListV3.VeloraGiftedSubscriptionsDetailsTemplateTextBox" AutomationProperties.Name="{x:Static resx:Resources.ItemTemplate}" />
                    <TextBox Grid.Row="3" Text="{Binding VeloraMassGiftedSubscriptionsDetailsTemplate}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.ItemTemplate}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayEventListV3.VeloraMassGiftedSubscriptionsDetailsTemplateTextBox" AutomationProperties.Name="{x:Static resx:Resources.ItemTemplate}" />
                </Grid>

                <TextBlock Grid.Row="18" Grid.Column="0" VerticalAlignment="Center" Text="{Binding Source={x:Static resx:Resources.Donations}, StringFormat={x:Static resx:Resources.ColumnHeaderFormat}}" />
                <CheckBox Grid.Row="18" Grid.Column="1" IsChecked="{Binding Donations}" VerticalAlignment="Center" Margin="5,0,0,0" AutomationProperties.AutomationId="OverlayEventListV3.DonationsCheckBox" AutomationProperties.Name="{x:Static resx:Resources.Donations}" />
                <TextBox Grid.Row="18" Grid.Column="3" Text="{Binding DonationsDetailsTemplate}" IsEnabled="{Binding Donations}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.ItemTemplate}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayEventListV3.DonationsDetailsTemplateTextBox" AutomationProperties.Name="{x:Static resx:Resources.ItemTemplate}" />

                <TextBlock Grid.Row="20" Grid.Column="0" VerticalAlignment="Center" Text="{Binding Source={x:Static resx:Resources.VeloraCheered}, StringFormat={x:Static resx:Resources.ColumnHeaderFormat}}" />
                <CheckBox Grid.Row="20" Grid.Column="1" IsChecked="{Binding VeloraCheered}" VerticalAlignment="Center" Margin="5,0,0,0" AutomationProperties.AutomationId="OverlayEventListV3.VeloraCheeredCheckBox" AutomationProperties.Name="{x:Static resx:Resources.VeloraCheered}" />
                <TextBox Grid.Row="20" Grid.Column="3" Text="{Binding VeloraCheeredDetailsTemplate}" IsEnabled="{Binding VeloraCheered}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.ItemTemplate}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayEventListV3.VeloraCheeredDetailsTemplateTextBox" AutomationProperties.Name="{x:Static resx:Resources.ItemTemplate}" />
            </Grid>
        </GroupBox>
    </Grid>
</Controls:LoadingControlBase>

