<Controls:LoadingControlBase x:Class="MixItUp.WPF.Controls.Overlay.OverlayDiscordReactiveVoiceV3Control"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MixItUp.WPF.Controls.Overlay"
             xmlns:Util="clr-namespace:MixItUp.WPF.Util"
             xmlns:resx="clr-namespace:MixItUp.Base;assembly=MixItUp.Base"
             xmlns:Controls="clr-namespace:MixItUp.WPF.Controls"
             xmlns:CommandControls="clr-namespace:MixItUp.WPF.Controls.Commands"
             xmlns:OverlayControls="clr-namespace:MixItUp.WPF.Controls.Overlay"
             xmlns:MaterialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Controls:LoadingControlBase.Resources>
        <Util:LocalizationConverter x:Key="LocalizationConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Controls:LoadingControlBase.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0" SelectedItem="{Binding SelectedVoiceChannel}" ItemsSource="{Binding VoiceChannels}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.VoiceChannel}" Style="{StaticResource MaterialDesignFloatingHintComboBox}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.AutomationId="OverlayDiscordReactiveVoiceV3.VoiceChannelComboBox" AutomationProperties.Name="{x:Static resx:Resources.VoiceChannel}">
                <ComboBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ComboBox.ItemsPanel>
            </ComboBox>

            <TextBox Grid.Column="2" Text="{Binding UserWidth}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.UserWidth}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" VerticalAlignment="Center" AutomationProperties.AutomationId="OverlayDiscordReactiveVoiceV3.UserWidthTextBox" AutomationProperties.Name="{x:Static resx:Resources.UserWidth}" />
            <TextBox Grid.Column="4" Text="{Binding UserHeight}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.UserHeight}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" VerticalAlignment="Center" AutomationProperties.AutomationId="OverlayDiscordReactiveVoiceV3.UserHeightTextBox" AutomationProperties.Name="{x:Static resx:Resources.UserHeight}" />
            <TextBox Grid.Column="6" Text="{Binding UserSpacing}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.UserSpacing}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" VerticalAlignment="Center" AutomationProperties.AutomationId="OverlayDiscordReactiveVoiceV3.UserSpacingTextBox" AutomationProperties.Name="{x:Static resx:Resources.UserSpacing}" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding Source={x:Static resx:Resources.IncludeSelf}, StringFormat={x:Static resx:Resources.ColumnHeaderFormat}}" />
            <CheckBox Grid.Column="1" IsChecked="{Binding IncludeSelf}" VerticalAlignment="Center" Margin="5,0,0,0" AutomationProperties.AutomationId="OverlayDiscordReactiveVoiceV3.IncludeSelfCheckBox" AutomationProperties.Name="{x:Static resx:Resources.IncludeSelf}" />

            <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{Binding Source={x:Static resx:Resources.OnlyShowAddedUsers}, StringFormat={x:Static resx:Resources.ColumnHeaderFormat}}" />
            <CheckBox Grid.Column="4" IsChecked="{Binding OnlyShowAddedUsers}" VerticalAlignment="Center" Margin="5,0,0,0" AutomationProperties.AutomationId="OverlayDiscordReactiveVoiceV3.OnlyShowAddedUsersCheckBox" AutomationProperties.Name="{x:Static resx:Resources.OnlyShowAddedUsers}" />

            <TextBlock Grid.Column="6" VerticalAlignment="Center" Text="{Binding Source={x:Static resx:Resources.DimInactiveUsers}, StringFormat={x:Static resx:Resources.ColumnHeaderFormat}}" />
            <CheckBox Grid.Column="7" IsChecked="{Binding DimInactiveUsers}" VerticalAlignment="Center" Margin="5,0,0,0" AutomationProperties.AutomationId="OverlayDiscordReactiveVoiceV3.DimInactiveUsersCheckBox" AutomationProperties.Name="{x:Static resx:Resources.DimInactiveUsers}" />
        </Grid>

        <GroupBox Header="{x:Static resx:Resources.NameDisplay}" Grid.Row="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="180" />
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0" ItemsSource="{Binding NameDisplays}" SelectedItem="{Binding SelectedNameDisplay}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.DisplayFormat}" Style="{StaticResource MaterialDesignFloatingHintComboBox}" AutomationProperties.AutomationId="OverlayDiscordReactiveVoiceV3.DisplayFormatComboBox" AutomationProperties.Name="{x:Static resx:Resources.DisplayFormat}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource LocalizationConverter}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBox Text="{Binding FontSize}" Grid.Column="2" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.FontSize}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayDiscordReactiveVoiceV3.FontSizeTextBox" AutomationProperties.Name="{x:Static resx:Resources.FontSize}" />

                    <ComboBox Text="{Binding FontName}" Grid.Column="4" ItemsSource="{Binding Fonts}" IsEditable="True" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.FontName}" Style="{StaticResource MaterialDesignFloatingHintComboBox}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.AutomationId="OverlayDiscordReactiveVoiceV3.FontNameComboBox" AutomationProperties.Name="{x:Static resx:Resources.FontName}">
                        <ComboBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ComboBox.ItemsPanel>
                    </ComboBox>

                    <Controls:ColorPickerTextBox ColorText="{Binding FontColor}" Grid.Column="6" HintText="{x:Static resx:Resources.FontColor}" AutomationProperties.AutomationId="OverlayDiscordReactiveVoiceV3.FontColorColorPicker" AutomationProperties.Name="{x:Static resx:Resources.FontColor}" />
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Controls:ColorPickerTextBox ColorText="{Binding ShadowColor}" Grid.Column="0" HintText="{x:Static resx:Resources.ShadowColor}" AutomationProperties.AutomationId="OverlayDiscordReactiveVoiceV3.ShadowColorColorPicker" AutomationProperties.Name="{x:Static resx:Resources.ShadowColor}" />

                    <ListBox Grid.Column="2" SelectionMode="Extended" Style="{StaticResource MaterialDesignToolToggleFlatListBox}" MaterialDesign:ListBoxAssist.CanUserToggleSelectedItem="True" AutomationProperties.AutomationId="OverlayDiscordReactiveVoiceV3.FontStyleList" AutomationProperties.Name="{x:Static resx:Resources.FontStyle}">
                        <ListBoxItem IsSelected="{Binding Bold}" AutomationProperties.AutomationId="OverlayDiscordReactiveVoiceV3.BoldItem" AutomationProperties.Name="{x:Static resx:Resources.Bold}">
                            <Controls:MaterialSymbolIcon IconName="format_bold" FontSize="{DynamicResource MIU.IconSize.16}" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" />
                        </ListBoxItem>
                        <ListBoxItem IsSelected="{Binding Italics}" AutomationProperties.AutomationId="OverlayDiscordReactiveVoiceV3.ItalicsItem" AutomationProperties.Name="{x:Static resx:Resources.Italics}">
                            <Controls:MaterialSymbolIcon IconName="format_italic" FontSize="{DynamicResource MIU.IconSize.16}" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" />
                        </ListBoxItem>
                        <ListBoxItem IsSelected="{Binding Underline}" AutomationProperties.AutomationId="OverlayDiscordReactiveVoiceV3.UnderlineItem" AutomationProperties.Name="{x:Static resx:Resources.Underline}">
                            <Controls:MaterialSymbolIcon IconName="format_underlined" FontSize="{DynamicResource MIU.IconSize.16}" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" />
                        </ListBoxItem>
                    </ListBox>

                    <ListBox Grid.Column="4" SelectionMode="Single" Style="{StaticResource MaterialDesignToolToggleFlatListBox}" AutomationProperties.AutomationId="OverlayDiscordReactiveVoiceV3.TextAlignmentList" AutomationProperties.Name="{x:Static resx:Resources.TextAlignment}">
                        <ListBoxItem IsSelected="{Binding LeftAlignment}" AutomationProperties.AutomationId="OverlayDiscordReactiveVoiceV3.LeftAlignmentItem" AutomationProperties.Name="{x:Static resx:Resources.LeftAlignment}">
                            <Controls:MaterialSymbolIcon IconName="format_align_left" FontSize="{DynamicResource MIU.IconSize.16}" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" />
                        </ListBoxItem>
                        <ListBoxItem IsSelected="{Binding CenterAlignment}" AutomationProperties.AutomationId="OverlayDiscordReactiveVoiceV3.CenterAlignmentItem" AutomationProperties.Name="{x:Static resx:Resources.CenterAlignment}">
                            <Controls:MaterialSymbolIcon IconName="format_align_center" FontSize="{DynamicResource MIU.IconSize.16}" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" />
                        </ListBoxItem>
                        <ListBoxItem IsSelected="{Binding RightAlignment}" AutomationProperties.AutomationId="OverlayDiscordReactiveVoiceV3.RightAlignmentItem" AutomationProperties.Name="{x:Static resx:Resources.RightAlignment}">
                            <Controls:MaterialSymbolIcon IconName="format_align_right" FontSize="{DynamicResource MIU.IconSize.16}" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" />
                        </ListBoxItem>
                        <ListBoxItem IsSelected="{Binding JustifyAlignment}" AutomationProperties.AutomationId="OverlayDiscordReactiveVoiceV3.JustifyAlignmentItem" AutomationProperties.Name="{x:Static resx:Resources.JustifyAlignment}">
                            <Controls:MaterialSymbolIcon IconName="format_align_justify" FontSize="{DynamicResource MIU.IconSize.16}" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" />
                        </ListBoxItem>
                    </ListBox>
                </Grid>
            </Grid>
        </GroupBox>

        <GroupBox Header="{x:Static resx:Resources.CustomUserDisplays}" Grid.Row="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" HorizontalAlignment="Center" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Text="{Binding AddDiscordUsername}" Grid.Column="0" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.DiscordUsername}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayDiscordReactiveVoiceV3.DiscordUsernameTextBox" AutomationProperties.Name="{x:Static resx:Resources.DiscordUsername}" />
                    <Button Grid.Column="2" Command="{Binding AddUserCommand}" Content="{x:Static resx:Resources.Add}" Width="100" AutomationProperties.AutomationId="OverlayDiscordReactiveVoiceV3.AddButton" />
                </Grid>

                <ItemsControl Grid.Row="2" ItemsSource="{Binding Users}" AutomationProperties.AutomationId="OverlayDiscordReactiveVoiceV3.CustomUserDisplaysList" AutomationProperties.Name="{x:Static resx:Resources.Users}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <!--<RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />-->
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding FullDisplayName}" Grid.Column="0" VerticalAlignment="Center" Margin="0,10,0,0" />

                                    <TextBox Text="{Binding CustomWidth}" Grid.Column="2" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.UserWidth}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="CustomUserDisplay.UserWidthTextBox" AutomationProperties.Name="{x:Static resx:Resources.UserWidth}" />
                                    <TextBox Text="{Binding CustomHeight}" Grid.Column="4" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.UserHeight}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="CustomUserDisplay.UserHeightTextBox" AutomationProperties.Name="{x:Static resx:Resources.UserHeight}" />

                                    <Controls:IconButton Grid.Column="6" Command="{Binding DeleteCommand}" VerticalAlignment="Center" Icon="delete" ToolTip="{x:Static resx:Resources.Delete}" AutomationProperties.AutomationId="CustomUserDisplay.DeleteButton" AutomationProperties.Name="{x:Static resx:Resources.Delete}" />
                                </Grid>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox Text="{Binding CustomActiveImageFilePath}" Grid.Column="0" VerticalAlignment="Center" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.ActiveImage}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="CustomUserDisplay.ActiveImageTextBox" AutomationProperties.Name="{x:Static resx:Resources.ActiveImage}" />
                                    <Button Grid.Column="1" Command="{Binding BrowseCustomActiveImageFilePathCommand}" Content="{x:Static resx:Resources.Browse}" VerticalAlignment="Center" AutomationProperties.AutomationId="CustomUserDisplay.ActiveImageBrowseButton" AutomationProperties.Name="{x:Static resx:Resources.Browse}" />

                                    <TextBox Text="{Binding CustomInactiveImageFilePath}" Grid.Column="3" VerticalAlignment="Center" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.InactiveImage}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="CustomUserDisplay.InactiveImageTextBox" AutomationProperties.Name="{x:Static resx:Resources.InactiveImage}" />
                                    <Button Grid.Column="4" Command="{Binding BrowseCustomInactiveImageFilePathCommand}" Content="{x:Static resx:Resources.Browse}" VerticalAlignment="Center" AutomationProperties.AutomationId="CustomUserDisplay.InactiveImageBrowseButton" AutomationProperties.Name="{x:Static resx:Resources.Browse}" />
                                </Grid>

                                <!--<Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox Text="{Binding CustomMutedImageFilePath}" Grid.Column="0" VerticalAlignment="Center" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.MutedImage}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" />
                                    <Button Grid.Column="1" Command="{Binding BrowseCustomMutedImageFilePathCommand}" Content="{x:Static resx:Resources.Browse}" VerticalAlignment="Center"/>

                                    <TextBox Text="{Binding CustomDeafenImageFilePath}" Grid.Column="3" VerticalAlignment="Center" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.DeafenedImage}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" />
                                    <Button Grid.Column="4" Command="{Binding BrowseCustomDeafenImageFilePathCommand}" Content="{x:Static resx:Resources.Browse}" VerticalAlignment="Center"/>
                                </Grid>-->
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </GroupBox>
    </Grid>
</Controls:LoadingControlBase>
