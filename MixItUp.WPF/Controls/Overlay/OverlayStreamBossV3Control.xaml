<Controls:LoadingControlBase x:Class="MixItUp.WPF.Controls.Overlay.OverlayStreamBossV3Control"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MixItUp.WPF.Controls.Overlay"
             xmlns:Util="clr-namespace:MixItUp.WPF.Util"
             xmlns:resx="clr-namespace:MixItUp.Base;assembly=MixItUp.Base"
             xmlns:Controls="clr-namespace:MixItUp.WPF.Controls"
             xmlns:CommandControls="clr-namespace:MixItUp.WPF.Controls.Commands"
             xmlns:OverlayControls="clr-namespace:MixItUp.WPF.Controls.Overlay"
             xmlns:MaterialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Controls:LoadingControlBase.Resources>
        <Util:LocalizationConverter x:Key="LocalizationConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Controls:LoadingControlBase.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Text="{Binding FontSize}" Grid.Column="0" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.FontSize}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayStreamBossV3.FontSizeTextBox" AutomationProperties.Name="{x:Static resx:Resources.FontSize}" />

            <ComboBox Text="{Binding FontName}" Grid.Column="2" ItemsSource="{Binding Fonts}" IsEditable="True" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.FontName}" Style="{StaticResource MaterialDesignFloatingHintComboBox}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.AutomationId="OverlayStreamBossV3.FontNameComboBox" AutomationProperties.Name="{x:Static resx:Resources.FontName}">
                <ComboBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ComboBox.ItemsPanel>
            </ComboBox>

            <Controls:ColorPickerTextBox ColorText="{Binding FontColor}" Grid.Column="4" HintText="{x:Static resx:Resources.FontColor}" AutomationProperties.AutomationId="OverlayStreamBossV3.FontColorColorPicker" AutomationProperties.Name="{x:Static resx:Resources.FontColor}" />

            <Controls:ColorPickerTextBox ColorText="{Binding ShadowColor}" Grid.Column="6" HintText="{x:Static resx:Resources.ShadowColor}" AutomationProperties.AutomationId="OverlayStreamBossV3.ShadowColorColorPicker" AutomationProperties.Name="{x:Static resx:Resources.ShadowColor}" />

            <ListBox Grid.Column="8" SelectionMode="Extended" Style="{StaticResource MaterialDesignToolToggleFlatListBox}" MaterialDesign:ListBoxAssist.CanUserToggleSelectedItem="True" AutomationProperties.AutomationId="OverlayStreamBossV3.FontStyleList" AutomationProperties.Name="{x:Static resx:Resources.FontStyle}">
                <ListBoxItem IsSelected="{Binding Bold}" AutomationProperties.AutomationId="OverlayStreamBossV3.BoldItem" AutomationProperties.Name="{x:Static resx:Resources.Bold}">
                    <Controls:MaterialSymbolIcon IconName="format_bold" FontSize="{DynamicResource MIU.IconSize.16}" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" />
                </ListBoxItem>
                <ListBoxItem IsSelected="{Binding Italics}" AutomationProperties.AutomationId="OverlayStreamBossV3.ItalicsItem" AutomationProperties.Name="{x:Static resx:Resources.Italics}">
                    <Controls:MaterialSymbolIcon IconName="format_italic" FontSize="{DynamicResource MIU.IconSize.16}" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" />
                </ListBoxItem>
                <ListBoxItem IsSelected="{Binding Underline}" AutomationProperties.AutomationId="OverlayStreamBossV3.UnderlineItem" AutomationProperties.Name="{x:Static resx:Resources.Underline}">
                    <Controls:MaterialSymbolIcon IconName="format_underlined" FontSize="{DynamicResource MIU.IconSize.16}" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" />
                </ListBoxItem>
            </ListBox>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Controls:ColorPickerTextBox ColorText="{Binding BorderColor}" Grid.Column="0" HintText="{x:Static resx:Resources.BorderColor}" AutomationProperties.AutomationId="OverlayStreamBossV3.BorderColorColorPicker" AutomationProperties.Name="{x:Static resx:Resources.BorderColor}" />

            <Controls:ColorPickerTextBox ColorText="{Binding BackgroundColor}" Grid.Column="2" HintText="{x:Static resx:Resources.BackgroundColor}" AutomationProperties.AutomationId="OverlayStreamBossV3.BackgroundColorColorPicker" AutomationProperties.Name="{x:Static resx:Resources.BackgroundColor}" />

            <Controls:ColorPickerTextBox ColorText="{Binding HealthColor}" Grid.Column="4" HintText="{x:Static resx:Resources.HealthColor}" AutomationProperties.AutomationId="OverlayStreamBossV3.HealthColorColorPicker" AutomationProperties.Name="{x:Static resx:Resources.HealthColor}" />

            <Controls:ColorPickerTextBox ColorText="{Binding DamageColor}" Grid.Column="6" HintText="{x:Static resx:Resources.DamageColor}" AutomationProperties.AutomationId="OverlayStreamBossV3.DamageColorColorPicker" AutomationProperties.Name="{x:Static resx:Resources.DamageColor}" />

            <TextBox Text="{Binding Height}" Grid.Column="8" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.Height}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayStreamBossV3.HeightTextBox" AutomationProperties.Name="{x:Static resx:Resources.Height}" />

            <TextBox Text="{Binding Width}" Grid.Column="10" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.Width}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayStreamBossV3.WidthTextBox" AutomationProperties.Name="{x:Static resx:Resources.Width}" />
        </Grid>

        <Rectangle VerticalAlignment="Center" HorizontalAlignment="Stretch" Grid.Row="4" Fill="{DynamicResource PrimaryHueMidBrush}" Height="4" />

        <Grid Grid.Row="6" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <CommandControls:CustomCommandListingControl Grid.Column="0" DataContext="{Binding DamageOccurredCommand}" Header="{x:Static resx:Resources.DamageOccurred}" />

            <CommandControls:CustomCommandListingControl Grid.Column="2" DataContext="{Binding HealingOccurredCommand}" Header="{x:Static resx:Resources.HealingOccurred}" />

            <CommandControls:CustomCommandListingControl Grid.Column="4" DataContext="{Binding NewBossCommand}" Header="{x:Static resx:Resources.NewBoss}" />
        </Grid>
        
        <Grid Grid.Row="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBox Text="{Binding BaseHealth}" Grid.Column="0" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.BaseHealth}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayStreamBossV3.BaseHealthTextBox" AutomationProperties.Name="{x:Static resx:Resources.BaseHealth}" />

            <TextBox Text="{Binding KillBonusHealth}" Grid.Column="2" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.KillBonusHealth}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayStreamBossV3.KillBonusHealthTextBox" AutomationProperties.Name="{x:Static resx:Resources.KillBonusHealth}" />

            <TextBox Text="{Binding OverkillBonusHealthMultiplier}" Grid.Column="4" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.OverkillBonusHealthMultiplier}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayStreamBossV3.OverkillBonusHealthMultiplierTextBox" AutomationProperties.Name="{x:Static resx:Resources.OverkillBonusHealthMultiplier}" />

            <TextBox Text="{Binding SelfHealingMultiplier}" Grid.Column="6" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.SelfHealingMultiplier}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayStreamBossV3.SelfHealingMultiplierTextBox" AutomationProperties.Name="{x:Static resx:Resources.SelfHealingMultiplier}" />
        </Grid>

        <Grid Grid.Row="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding Source={x:Static resx:Resources.CompoundPreviousBossHealth}, StringFormat={x:Static resx:Resources.ColumnHeaderFormat}}" />
            <CheckBox Grid.Column="1" IsChecked="{Binding CompoundPreviousBossHealth}" VerticalAlignment="Center" Margin="5,0,0,0" AutomationProperties.AutomationId="OverlayStreamBossV3.CompoundPreviousBossHealthCheckBox" AutomationProperties.Name="{x:Static resx:Resources.CompoundPreviousBossHealth}" />
        </Grid>

        <Grid Grid.Row="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <GroupBox Header="{x:Static resx:Resources.Follows}" Grid.Row="0" Grid.Column="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox Grid.Column="0" Text="{Binding FollowAmount}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.DamageAmount}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayStreamBossV3.FollowsDamageAmountTextBox" AutomationProperties.Name="{x:Static resx:Resources.DamageAmount}" />
                </Grid>
            </GroupBox>

            <GroupBox Header="{x:Static resx:Resources.Raids}" Grid.Row="0" Grid.Column="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" Text="{Binding RaidAmount}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.DamageAmount}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayStreamBossV3.RaidsDamageAmountTextBox" AutomationProperties.Name="{x:Static resx:Resources.DamageAmount}" />

                        <TextBox Grid.Column="2" Text="{Binding RaidPerViewAmount}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.DamageMultiplier}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayStreamBossV3.RaidsDamageMultiplierTextBox" AutomationProperties.Name="{x:Static resx:Resources.DamageMultiplier}" />
                    </Grid>

                    <TextBlock Grid.Row="2" Text="{Binding RaidEquation}" />
                </Grid>
            </GroupBox>

            <GroupBox Header="{x:Static resx:Resources.TwitchSubscriptions}" Grid.Row="2" Grid.ColumnSpan="3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding Source={x:Static resx:Resources.Tier1}, StringFormat={x:Static resx:Resources.ColumnHeaderFormat}}" VerticalAlignment="Bottom" Margin="0,0,10,5" />
                    <TextBox Grid.Column="1" Text="{Binding TwitchSubscriptionTier1Amount}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.DamageAmount}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayStreamBossV3.TwitchSubscriptionTier1AmountTextBox" AutomationProperties.Name="{x:Static resx:Resources.DamageAmount}" />

                    <TextBlock Grid.Column="2" Text="{Binding Source={x:Static resx:Resources.Tier2}, StringFormat={x:Static resx:Resources.ColumnHeaderFormat}}" VerticalAlignment="Bottom" Margin="10,0,10,5" />
                    <TextBox Grid.Column="3" Text="{Binding TwitchSubscriptionTier2Amount}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.DamageAmount}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayStreamBossV3.TwitchSubscriptionTier2AmountTextBox" AutomationProperties.Name="{x:Static resx:Resources.DamageAmount}" />

                    <TextBlock Grid.Column="4" Text="{Binding Source={x:Static resx:Resources.Tier3}, StringFormat={x:Static resx:Resources.ColumnHeaderFormat}}" VerticalAlignment="Bottom" Margin="10,0,10,5" />
                    <TextBox Grid.Column="5" Text="{Binding TwitchSubscriptionTier3Amount}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.DamageAmount}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayStreamBossV3.TwitchSubscriptionTier3AmountTextBox" AutomationProperties.Name="{x:Static resx:Resources.DamageAmount}" />
                </Grid>
            </GroupBox>

            <GroupBox Header="{x:Static resx:Resources.YouTubeMemberships}" Grid.Row="4" Grid.ColumnSpan="3">
                <ItemsControl ItemsSource="{Binding YouTubeMemberships}" AutomationProperties.AutomationId="OverlayStreamBossV3.EventTypesList" AutomationProperties.Name="{x:Static resx:Resources.EventTypes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="10,0,10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding Name, StringFormat={x:Static resx:Resources.ColumnHeaderFormat}}" VerticalAlignment="Bottom" Margin="0,0,5,0" />
                                <TextBox Grid.Column="2" Text="{Binding Amount}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.DamageAmount}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="EventType.DamageAmountTextBox" AutomationProperties.Name="{x:Static resx:Resources.DamageAmount}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </GroupBox>

            <GroupBox Header="{x:Static resx:Resources.KickSubscriptions}" Grid.Row="6" Grid.ColumnSpan="3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding Source={x:Static resx:Resources.Tier1}, StringFormat={x:Static resx:Resources.ColumnHeaderFormat}}" VerticalAlignment="Bottom" Margin="0,0,10,5" />
                    <TextBox Grid.Column="1" Text="{Binding KickSubscriptionAmount}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.DamageAmount}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayStreamBossV3.KickSubscriptionsDamageAmountTextBox" AutomationProperties.Name="{x:Static resx:Resources.DamageAmount}" />
                </Grid>
            </GroupBox>

            <GroupBox Header="{x:Static resx:Resources.VeloraSubscriptions}" Grid.Row="8" Grid.ColumnSpan="3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding Source={x:Static resx:Resources.Tier1}, StringFormat={x:Static resx:Resources.ColumnHeaderFormat}}" VerticalAlignment="Bottom" Margin="0,0,10,5" />
                    <TextBox Grid.Column="1" Text="{Binding VeloraSubscriptionAmount}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.DamageAmount}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayStreamBossV3.VeloraSubscriptionsDamageAmountTextBox" AutomationProperties.Name="{x:Static resx:Resources.DamageAmount}" />
                </Grid>
            </GroupBox>

            <GroupBox Header="{x:Static resx:Resources.TwitchBits}" Grid.Row="10" Grid.Column="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox Grid.Row="0" Text="{Binding TwitchBitsAmount}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.DamageMultiplier}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayStreamBossV3.TwitchBitsDamageMultiplierTextBox" AutomationProperties.Name="{x:Static resx:Resources.DamageMultiplier}" />

                    <TextBlock Grid.Row="2" Text="{Binding TwitchBitsEquation}" />
                </Grid>
            </GroupBox>

            <GroupBox Header="{x:Static resx:Resources.YouTubeSuperChat}" Grid.Row="10" Grid.Column="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox Grid.Row="0" Text="{Binding YouTubeSuperChatAmount}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.DamageMultiplier}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayStreamBossV3.YouTubeSuperChatDamageMultiplierTextBox" AutomationProperties.Name="{x:Static resx:Resources.DamageMultiplier}" />

                    <TextBlock Grid.Row="2" Text="{Binding YouTubeSuperChatEquation}" />
                </Grid>
            </GroupBox>

            <GroupBox Header="{x:Static resx:Resources.KickKicks}" Grid.Row="12" Grid.Column="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox Grid.Row="0" Text="{Binding KickKicksAmount}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.DamageMultiplier}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayStreamBossV3.KickKicksDamageMultiplierTextBox" AutomationProperties.Name="{x:Static resx:Resources.DamageMultiplier}" />

                    <TextBlock Grid.Row="2" Text="{Binding KickKicksEquation}" />
                </Grid>
            </GroupBox>

            <GroupBox Header="{x:Static resx:Resources.VeloraCheered}" Grid.Row="14" Grid.Column="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox Grid.Row="0" Text="{Binding VeloraCheeredAmount}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.DamageMultiplier}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayStreamBossV3.VeloraCheeredDamageMultiplierTextBox" AutomationProperties.Name="{x:Static resx:Resources.DamageMultiplier}" />

                    <TextBlock Grid.Row="2" Text="{Binding VeloraCheeredEquation}" />
                </Grid>
            </GroupBox>

            <GroupBox Header="{x:Static resx:Resources.Donations}" Grid.Row="12" Grid.Column="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox Grid.Row="0" Text="{Binding DonationAmount}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.DamageMultiplier}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="OverlayStreamBossV3.DonationsDamageMultiplierTextBox" AutomationProperties.Name="{x:Static resx:Resources.DamageMultiplier}" />

                    <TextBlock Grid.Row="2" Text="{Binding DonationEquation}" />
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</Controls:LoadingControlBase>

