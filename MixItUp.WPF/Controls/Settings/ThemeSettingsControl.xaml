<local:SettingsControlBase x:Class="MixItUp.WPF.Controls.Settings.ThemeSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MixItUp.WPF.Controls.Settings"
             xmlns:resx="clr-namespace:MixItUp.Base;assembly=MixItUp.Base"
             xmlns:System="clr-namespace:System;assembly=System.Runtime"
             xmlns:MaterialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:GenericSettingsControls="clr-namespace:MixItUp.WPF.Controls.Settings.Generic"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="20">
        <StackPanel>
            <GenericSettingsControls:GenericToggleSettingsOptionControl DataContext="{Binding SupportMode}" />
            <Separator Margin="10" />

            <GenericSettingsControls:GenericColorComboBoxSettingsOptionControl
                DataContext="{Binding ColorScheme}"
                IsEnabled="{Binding DataContext.IsColorSchemeEnabled, RelativeSource={RelativeSource AncestorType=local:SettingsControlBase}}" />

            <GenericSettingsControls:GenericComboBoxSettingsOptionControl 
                DataContext="{Binding BackgroundColor}" 
                IsEnabled="{Binding DataContext.IsBackgroundColorEnabled, RelativeSource={RelativeSource AncestorType=local:SettingsControlBase}}" />

            <GenericSettingsControls:GenericComboBoxSettingsOptionControl 
                DataContext="{Binding ForegroundColor}" 
                IsEnabled="{Binding DataContext.IsForegroundColorEnabled, RelativeSource={RelativeSource AncestorType=local:SettingsControlBase}}" />

            <Separator Margin="10" />
            <GenericSettingsControls:GenericComboBoxSettingsOptionControl
                DataContext="{Binding FullTheme}"
                IsEnabled="{Binding DataContext.AreThemeControlsEnabled, RelativeSource={RelativeSource AncestorType=local:SettingsControlBase}}" />

            <Separator Margin="10" />
            <GenericSettingsControls:GenericComboBoxSettingsOptionControl
                DataContext="{Binding UIFont}"
                IsEnabled="{Binding DataContext.AreThemeControlsEnabled, RelativeSource={RelativeSource AncestorType=local:SettingsControlBase}}" />
            <GenericSettingsControls:GenericSliderSettingsOptionControl
                DataContext="{Binding UIScale}"
                IsEnabled="{Binding DataContext.AreThemeControlsEnabled, RelativeSource={RelativeSource AncestorType=local:SettingsControlBase}}" />
            <TextBlock
                Margin="20,-4,20,6"
                FontSize="{DynamicResource MIU.FontSize.BodySmall}"
                Opacity="0.75"
                TextAlignment="Left"
                TextWrapping="Wrap"
                Text="{x:Static resx:Resources.OverallFontSizeNote}" />
            <GenericSettingsControls:GenericSliderSettingsOptionControl
                DataContext="{Binding ChatWindowFontSize}"
                IsEnabled="{Binding DataContext.AreThemeControlsEnabled, RelativeSource={RelativeSource AncestorType=local:SettingsControlBase}}" />

            <Separator Margin="10" />
            <GenericSettingsControls:GenericButtonSettingsOptionControl
                DataContext="{Binding ResetToDefaults}"
                IsEnabled="{Binding DataContext.AreThemeControlsEnabled, RelativeSource={RelativeSource AncestorType=local:SettingsControlBase}}" />
        </StackPanel>
    </Grid>
</local:SettingsControlBase>