<MainControls:MainControlBase x:Class="MixItUp.WPF.Controls.Settings.MainSettingsContainerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:resx="clr-namespace:MixItUp.Base;assembly=MixItUp.Base"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MixItUp.WPF.Controls.Settings"
             xmlns:MaterialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:MainControls="clr-namespace:MixItUp.WPF.Controls.MainControls"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <ListBox x:Name="SettingsItemsListBox" Grid.Column="0" Margin="0 16 0 16" SelectionChanged="SettingsItemsListBox_SelectionChanged" AutomationProperties.AutomationId="MainSettingsContainer.SettingsSectionsList" AutomationProperties.Name="{x:Static resx:Resources.Settings}">
            <ListBox.ItemContainerStyle>
                <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                    <!--  The settings option has no ToString override, so without this each entry
                          announces its type name instead of the section it opens  -->
                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                    <Setter Property="AutomationProperties.AutomationId" Value="SettingsSection" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="32 0 32 0">
                        <TextBlock Text="{Binding Name}" Margin="0 0 5 0" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Column="1" BorderThickness="1" BorderBrush="{DynamicResource MaterialDesign.Brush.Primary}" />

        <Grid Grid.Column="2">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ContentControl x:Name="SettingsContent" Margin="10" />
            </ScrollViewer>

            <!--  Pages that fill the available height sit outside the scroll viewer, which would otherwise
                  measure them against infinite height and leave them sized to their content  -->
            <ContentControl x:Name="SettingsFillContent" Margin="10" />
        </Grid>
    </Grid>
</MainControls:MainControlBase>
