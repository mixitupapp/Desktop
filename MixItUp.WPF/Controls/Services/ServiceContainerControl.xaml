<Controls:LoadingControlBase x:Class="MixItUp.WPF.Controls.Services.ServiceContainerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MixItUp.WPF.Controls.Actions"
             xmlns:Controls="clr-namespace:MixItUp.WPF.Controls"
             xmlns:resx="clr-namespace:MixItUp.Base;assembly=MixItUp.Base"
             xmlns:MaterialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <Controls:LoadingControlBase.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </Controls:LoadingControlBase.Resources>
    <Controls:AccordianGroupBoxControl x:Name="GroupBox">
        <GroupBox.Header>
            <Grid Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!--  Kept at/below the header text's line height so the icon never drives the minimized header's height  -->
                <Grid x:Name="BrandIconContainer" Grid.Column="0" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed">
                    <Image x:Name="BrandImage" Visibility="Collapsed" />
                    <Controls:MaterialSymbolIcon x:Name="FeatureIcon" FontSize="{DynamicResource MIU.IconSize.16}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" Visibility="Collapsed" />
                </Grid>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" Text="{Binding Name}" />
                <Rectangle Grid.Column="2" Fill="{DynamicResource MaterialDesign.Brush.Primary}" />
                <Controls:MaterialSymbolIcon Grid.Column="3" IconName="check_circle" FontSize="{DynamicResource MIU.IconSize.16}" VerticalAlignment="Center" Foreground="White" Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Controls:IconButton Grid.Column="5" Style="{StaticResource GroupBoxHeaderIconButton}" Command="{Binding HelpCommand}" Icon="help" ToolTip="{x:Static resx:Resources.Help}" />
            </Grid>
        </GroupBox.Header>
        <ContentControl x:Name="InnerContentControl" Margin="10" HorizontalAlignment="Center" VerticalAlignment="Center" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch" />
    </Controls:AccordianGroupBoxControl>
</Controls:LoadingControlBase>