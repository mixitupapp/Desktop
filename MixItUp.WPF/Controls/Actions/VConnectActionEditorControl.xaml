<local:ActionEditorControlBase x:Class="MixItUp.WPF.Controls.Actions.VConnectActionEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:resx="clr-namespace:MixItUp.Base;assembly=MixItUp.Base"
             xmlns:local="clr-namespace:MixItUp.WPF.Controls.Actions"
             xmlns:Util="clr-namespace:MixItUp.WPF.Util"
             xmlns:MaterialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:Controls="clr-namespace:MixItUp.WPF.Controls"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <local:ActionEditorControlBase.Resources>
        <Util:LocalizationConverter x:Key="LocalizationConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </local:ActionEditorControlBase.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Visibility="{Binding VConnectNotConnected, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="Red" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,10" Text="{x:Static resx:Resources.VConnectNotConnected}"/>

        <ComboBox Grid.Row="1" ItemsSource="{Binding ActionTypes}" SelectedItem="{Binding SelectedActionType}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.Action}" Style="{StaticResource MaterialDesignFloatingHintComboBox}" AutomationProperties.AutomationId="VConnectActionEditor.ActionComboBox" AutomationProperties.Name="{x:Static resx:Resources.Action}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource LocalizationConverter}}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <Grid Grid.Row="3" Visibility="{Binding ShowTriggerGrid, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0" ItemsSource="{Binding Triggers}" SelectedItem="{Binding SelectedTrigger}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.VConnectTrigger}" Style="{StaticResource MaterialDesignFloatingHintComboBox}" DisplayMemberPath="DisplayName" AutomationProperties.AutomationId="VConnectActionEditor.TriggerComboBox" AutomationProperties.Name="{x:Static resx:Resources.VConnectTrigger}" />

            <Controls:IconButton Grid.Column="2" Command="{Binding RefreshCommand}" IsEnabled="{Binding RefreshCommandEnabled}" Icon="Refresh" ToolTip="{x:Static resx:Resources.Refresh}" AutomationProperties.AutomationId="VConnectActionEditor.RefreshTriggersButton" AutomationProperties.Name="{x:Static resx:Resources.Refresh}" />
        </Grid>

        <Grid Grid.Row="3" Visibility="{Binding ShowCustomMessageGrid, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBox Grid.Row="0" Text="{Binding MessageChannel}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.VConnectMessageChannel}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="VConnectActionEditor.MessageChannelTextBox" AutomationProperties.Name="{x:Static resx:Resources.VConnectMessageChannel}" />

            <TextBox Grid.Row="2" Text="{Binding MessageArguments}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinLines="3" MaxLines="6" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.VConnectMessageArguments}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="VConnectActionEditor.MessageArgumentsTextBox" AutomationProperties.Name="{x:Static resx:Resources.VConnectMessageArguments}" />

            <TextBlock Grid.Row="4" TextWrapping="Wrap" Text="{x:Static resx:Resources.VConnectMessageArgumentsInfo}" />
        </Grid>

        <Grid Grid.Row="3" Visibility="{Binding ShowAssetGrid, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0" ItemsSource="{Binding Assets}" SelectedItem="{Binding SelectedAsset}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.VConnectAsset}" Style="{StaticResource MaterialDesignFloatingHintComboBox}" DisplayMemberPath="DisplayName" AutomationProperties.AutomationId="VConnectActionEditor.AssetComboBox" AutomationProperties.Name="{x:Static resx:Resources.VConnectAsset}" />

                <Controls:IconButton Grid.Column="2" Command="{Binding RefreshCommand}" IsEnabled="{Binding RefreshCommandEnabled}" Icon="Refresh" ToolTip="{x:Static resx:Resources.Refresh}" AutomationProperties.AutomationId="VConnectActionEditor.RefreshAssetsButton" AutomationProperties.Name="{x:Static resx:Resources.Refresh}" />
            </Grid>

            <TextBox Grid.Row="2" Text="{Binding ScreenshotFilePath}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.VConnectScreenshotFilePath}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="VConnectActionEditor.ScreenshotFilePathTextBox" AutomationProperties.Name="{x:Static resx:Resources.VConnectScreenshotFilePath}" />

            <TextBlock Grid.Row="4" TextWrapping="Wrap" Text="{x:Static resx:Resources.VConnectScreenshotFilePathInfo}" />
        </Grid>
    </Grid>
</local:ActionEditorControlBase>
