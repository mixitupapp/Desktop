<local:ActionEditorControlBase x:Class="MixItUp.WPF.Controls.Actions.VeadotubeActionEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:resx="clr-namespace:MixItUp.Base;assembly=MixItUp.Base"
             xmlns:local="clr-namespace:MixItUp.WPF.Controls.Actions"
             xmlns:Util="clr-namespace:MixItUp.WPF.Util"
             xmlns:MaterialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:Controls="clr-namespace:MixItUp.WPF.Controls"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <local:ActionEditorControlBase.Resources>
        <Util:LocalizationConverter x:Key="LocalizationConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </local:ActionEditorControlBase.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Visibility="{Binding VeadotubeNotConnected, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="Red" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,10" Text="{x:Static resx:Resources.VeadotubeNotConnected}"/>

        <ComboBox Grid.Row="1" ItemsSource="{Binding ActionTypes}" SelectedItem="{Binding SelectedActionType}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.Action}" Style="{StaticResource MaterialDesignFloatingHintComboBox}" AutomationProperties.AutomationId="VeadotubeActionEditor.ActionComboBox" AutomationProperties.Name="{x:Static resx:Resources.Action}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource LocalizationConverter}}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <Grid Grid.Row="3" Visibility="{Binding ShowAvatarStateGrid, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0" ItemsSource="{Binding States}" SelectedItem="{Binding SelectedState}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.VeadotubeAvatarState}" Style="{StaticResource MaterialDesignFloatingHintComboBox}" DisplayMemberPath="DisplayName" AutomationProperties.AutomationId="VeadotubeActionEditor.AvatarStateComboBox" AutomationProperties.Name="{x:Static resx:Resources.VeadotubeAvatarState}" />

            <Controls:IconButton Grid.Column="2" Command="{Binding RefreshCacheCommand}" Icon="Refresh" ToolTip="{x:Static resx:Resources.Refresh}" AutomationProperties.AutomationId="VeadotubeActionEditor.RefreshStatesButton" AutomationProperties.Name="{x:Static resx:Resources.Refresh}" />
        </Grid>

        <Grid Grid.Row="3" Visibility="{Binding ShowPushToTalkGrid, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ComboBox ItemsSource="{Binding PushToTalkTypes}" SelectedItem="{Binding SelectedPushToTalkType}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.VeadotubePushToTalk}" Style="{StaticResource MaterialDesignFloatingHintComboBox}" AutomationProperties.AutomationId="VeadotubeActionEditor.PushToTalkComboBox" AutomationProperties.Name="{x:Static resx:Resources.VeadotubePushToTalk}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource LocalizationConverter}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>
    </Grid>
</local:ActionEditorControlBase>
