<Controls:LoadingControlBase x:Class="MixItUp.WPF.Controls.Actions.ActionEditorContainerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MixItUp.WPF.Controls.Actions"
             xmlns:Controls="clr-namespace:MixItUp.WPF.Controls"
             xmlns:resx="clr-namespace:MixItUp.Base;assembly=MixItUp.Base"
             xmlns:System="clr-namespace:System;assembly=System.Runtime"
             xmlns:Util="clr-namespace:MixItUp.WPF.Util"
             xmlns:MaterialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Controls:LoadingControlBase.Resources>
        <Util:LocalizationConverter x:Key="LocalizationConverter"/>
        <Util:StrikethroughConverter x:Key="StrikethroughConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="LabelHeaderTextBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary.Dark}" />
        </Style>
    </Controls:LoadingControlBase.Resources>

    <Border Style="{StaticResource DefaultBorder}" BorderBrush="{DynamicResource MaterialDesign.Brush.Foreground}">
        <Controls:AccordianGroupBoxControl x:Name="ActionContainer" Maximized="ActionContainer_Maximized" Minimized="ActionContainer_Minimized">
            <Controls:AccordianGroupBoxControl.Header>
                <!--  Header controls sit fully inside the row (no negative-margin bleed): WPF layout-clips
                      anything that escapes its slot under fractional DPI rounding. The compact height comes
                      from the accordion style's reduced HeaderPadding instead.  -->
                <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" TextDecorations="{Binding Disabled, Converter={StaticResource StrikethroughConverter}}" Visibility="{Binding ShowNameTextBlock, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" Width="Auto"  />
                    <TextBox Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" TextDecorations="{Binding Disabled, Converter={StaticResource StrikethroughConverter}}" Visibility="{Binding ShowNameTextBox, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" Width="250" Style="{StaticResource LabelHeaderTextBox}" AutomationProperties.AutomationId="ActionEditorContainer.ActionNameTextBox" AutomationProperties.Name="{x:Static resx:Resources.Name}" />

                    <Rectangle Grid.Column="1" Fill="{DynamicResource MaterialDesign.Brush.Primary}" />

                    <Controls:IconButton Grid.Column="2" Style="{StaticResource GroupBoxHeaderIconButton}" Command="{Binding PlayCommand}" Icon="play_arrow" ToolTip="{x:Static resx:Resources.TestCommand}" AutomationProperties.AutomationId="ActionEditorContainer.TestCommandButton" AutomationProperties.Name="{x:Static resx:Resources.TestCommand}" />

                    <Controls:IconButton Grid.Column="4" Style="{StaticResource GroupBoxHeaderIconButton}" Command="{Binding MoveUpCommand}" Icon="arrow_upward" ToolTip="{x:Static resx:Resources.MoveUp}" AutomationProperties.AutomationId="ActionEditorContainer.MoveUpButton" AutomationProperties.Name="{x:Static resx:Resources.MoveUp}" />
                    <Controls:IconButton Grid.Column="6" Style="{StaticResource GroupBoxHeaderIconButton}" Command="{Binding MoveDownCommand}" Icon="arrow_downward" ToolTip="{x:Static resx:Resources.MoveDown}" AutomationProperties.AutomationId="ActionEditorContainer.MoveDownButton" AutomationProperties.Name="{x:Static resx:Resources.MoveDown}" />

                    <Controls:IconButton Grid.Column="8" Style="{StaticResource GroupBoxHeaderIconButton}" Command="{Binding CopyCommand}" Icon="content_copy" ToolTip="{x:Static resx:Resources.Duplicate}" AutomationProperties.AutomationId="ActionEditorContainer.DuplicateButton" AutomationProperties.Name="{x:Static resx:Resources.Duplicate}" />

                    <Controls:IconButton Grid.Column="10" Style="{StaticResource GroupBoxHeaderIconButton}" Command="{Binding HelpCommand}" Icon="help" ToolTip="{x:Static resx:Resources.Help}" AutomationProperties.AutomationId="ActionEditorContainer.HelpButton" AutomationProperties.Name="{x:Static resx:Resources.Help}" />

                    <Controls:IconButton Grid.Column="12" Style="{StaticResource GroupBoxHeaderIconButton}" Command="{Binding DeleteCommand}" Icon="delete" ToolTip="{x:Static resx:Resources.Delete}" AutomationProperties.AutomationId="ActionEditorContainer.DeleteButton" AutomationProperties.Name="{x:Static resx:Resources.Delete}" />

                    <ToggleButton Grid.Column="14" VerticalAlignment="Center" IsChecked="{Binding Enabled}" ToolTip="{x:Static resx:Resources.EnableDisable}" BorderBrush="{DynamicResource MaterialDesign.Brush.Primary.Light}" AutomationProperties.AutomationId="ActionEditorContainer.EnableDisableToggle" AutomationProperties.Name="{x:Static resx:Resources.EnableDisable}" />
                </Grid>
            </Controls:AccordianGroupBoxControl.Header>

            <Controls:AccordianGroupBoxControl.Content>
                <Grid>
                    <ContentControl x:Uid="ActionContentControl" Margin="10" />
                    <Grid Visibility="{Binding ShowNameTextBox, Converter={StaticResource BooleanToVisibilityConverter}}" IsHitTestVisible="False">
                        <Rectangle Grid.Column="1" Fill="#77555555" Visibility="{Binding Disabled, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="-9" IsHitTestVisible="False"/>
                    </Grid>
                </Grid>
            </Controls:AccordianGroupBoxControl.Content>
        </Controls:AccordianGroupBoxControl>
    </Border>
</Controls:LoadingControlBase>
