<local:ActionEditorControlBase x:Class="MixItUp.WPF.Controls.Actions.VeloraActionEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:resx="clr-namespace:MixItUp.Base;assembly=MixItUp.Base"
             xmlns:local="clr-namespace:MixItUp.WPF.Controls.Actions"
             xmlns:Util="clr-namespace:MixItUp.WPF.Util"
             xmlns:MaterialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <local:ActionEditorControlBase.Resources>
        <Util:LocalizationConverter x:Key="LocalizationConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </local:ActionEditorControlBase.Resources>

    <StackPanel>
        <ComboBox ItemsSource="{Binding ActionTypes}" SelectedItem="{Binding SelectedActionType}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.Type}" Style="{StaticResource MaterialDesignFloatingHintComboBox}" Margin="0,0,0,10">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource LocalizationConverter}}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBox Text="{Binding Text}" MaterialDesign:HintAssist.Hint="{Binding TextHint}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Visibility="{Binding ShowText, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,10" />

        <TextBox Text="{Binding TargetUsername}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.Username}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Visibility="{Binding ShowTargetUser, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,10" />

        <TextBox Text="{Binding Amount}" MaterialDesign:HintAssist.Hint="{Binding AmountHint}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Visibility="{Binding ShowAmount, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,10" />

        <TextBox Text="{Binding Reason}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.Reason}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Visibility="{Binding ShowReason, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,10" />

        <ComboBox ItemsSource="{Binding AnnounceColors}" SelectedItem="{Binding SelectedAnnounceColor}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.Color}" Style="{StaticResource MaterialDesignFloatingHintComboBox}" Visibility="{Binding ShowColor, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,10" />

        <Grid Visibility="{Binding ShowSendAsStreamer, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding Source={x:Static resx:Resources.SendAsStreamer}, StringFormat={x:Static resx:Resources.ColumnHeaderFormat}}" VerticalAlignment="Center" />
            <ToggleButton Grid.Column="2" IsChecked="{Binding SendAsStreamer}" VerticalAlignment="Center" />
        </Grid>
    </StackPanel>
</local:ActionEditorControlBase>
