<local:MainControlBase
    x:Class="MixItUp.WPF.Controls.MainControls.MusicPlayerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:CommandsControls="clr-namespace:MixItUp.WPF.Controls.Commands"
    xmlns:Controls="clr-namespace:MixItUp.WPF.Controls"
    xmlns:MaterialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:Util="clr-namespace:MixItUp.WPF.Util"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MixItUp.WPF.Controls.MainControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:MixItUp.Base;assembly=MixItUp.Base"
    d:DesignHeight="700"
    d:DesignWidth="800"
    FontFamily="{DynamicResource NotoSans}"
    TextElement.FontSize="{DynamicResource MIU.FontSize.BodyMedium}"
    TextElement.FontWeight="Medium"
    mc:Ignorable="d">
    <local:MainControlBase.Resources>
        <Util:MusicPlayerAlbumArtConverter x:Key="AlbumArtConverter" />
    </local:MainControlBase.Resources>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="15" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="15" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="{x:Static resx:Resources.NowPlaying}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Width="170"
                        Height="170"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource MaterialDesign.Brush.Background.Light}"
                        CornerRadius="4">
                        <Grid>
                            <Controls:MaterialSymbolIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IconName="music_note" FontSize="80"
                                Opacity="0.3" />
                            <Image Source="{Binding CurrentSong, Converter={StaticResource AlbumArtConverter}, ConverterParameter=400}" Stretch="Uniform" />
                        </Grid>
                    </Border>

                    <TextBlock
                        Grid.Row="2"
                        HorizontalAlignment="Center"
                        FontSize="{DynamicResource MIU.FontSize.BodyMedium}"
                        Text="{Binding CurrentlyPlayingSong}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis" />

                    <Slider
                        x:Name="TrackScrubber"
                        Grid.Row="4"
                        Margin="5,0"
                        VerticalAlignment="Center"
                        Maximum="{Binding TrackDuration, Mode=OneWay}"
                        Minimum="0"
                        Style="{StaticResource MaterialDesign3.MaterialDesignSlider}"
                        AutomationProperties.AutomationId="MusicPlayer.TrackScrubber"
                        AutomationProperties.Name="{x:Static resx:Resources.MusicPlayerTrackPosition}" />

                    <Grid Grid.Row="5" Margin="5,0">
                        <TextBlock
                            HorizontalAlignment="Left"
                            FontSize="{DynamicResource MIU.FontSize.LabelSmall}"
                            Opacity="0.8"
                            Text="{Binding TrackPositionString}" />
                        <TextBlock
                            HorizontalAlignment="Right"
                            FontSize="{DynamicResource MIU.FontSize.LabelSmall}"
                            Opacity="0.8"
                            Text="{Binding TrackDurationString}" />
                    </Grid>

                    <Grid Grid.Row="7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Controls:IconButton
                            Grid.Column="0"
                            Command="{Binding PreviousCommand}"
                            Icon="skip_previous"
                            AutomationProperties.AutomationId="MusicPlayer.PreviousTrackButton"
                            AutomationProperties.Name="{x:Static resx:Resources.MusicPlayerPreviousTrack}" />
                        <Controls:IconButton
                            Grid.Column="2"
                            Command="{Binding PlayPauseCommand}"
                            Icon="play_pause"
                            AutomationProperties.AutomationId="MusicPlayer.PlayPauseButton"
                            AutomationProperties.Name="{x:Static resx:Resources.MusicPlayerPlayPause}" />
                        <Controls:IconButton
                            Grid.Column="4"
                            Command="{Binding StopCommand}"
                            Icon="stop"
                            AutomationProperties.AutomationId="MusicPlayer.StopButton"
                            AutomationProperties.Name="{x:Static resx:Resources.Stop}" />
                        <Controls:IconButton
                            Grid.Column="6"
                            Command="{Binding NextCommand}"
                            Icon="skip_next"
                            AutomationProperties.AutomationId="MusicPlayer.NextTrackButton"
                            AutomationProperties.Name="{x:Static resx:Resources.MusicPlayerNextTrack}" />

                        <Grid Grid.Column="8">
                            <Controls:IconButton
                                Command="{Binding ToggleShuffleCommand}"
                                Icon="shuffle_on"
                                ToolTip="{x:Static resx:Resources.Shuffle}"
                                Visibility="{Binding IsShuffleOn, Converter={StaticResource BooleanToVisibilityConverter}}"
                                AutomationProperties.AutomationId="MusicPlayer.ShuffleOnButton"
                                AutomationProperties.Name="{x:Static resx:Resources.Shuffle}" />
                            <Controls:IconButton
                                Command="{Binding ToggleShuffleCommand}"
                                Icon="shuffle"
                                Opacity="0.55"
                                ToolTip="{x:Static resx:Resources.Shuffle}"
                                Visibility="{Binding IsShuffleOff, Converter={StaticResource BooleanToVisibilityConverter}}"
                                AutomationProperties.AutomationId="MusicPlayer.ShuffleOffButton"
                                AutomationProperties.Name="{x:Static resx:Resources.Shuffle}" />
                        </Grid>

                        <Grid Grid.Column="10">
                            <Controls:IconButton
                                Command="{Binding ToggleRepeatCommand}"
                                Icon="repeat_on"
                                ToolTip="{x:Static resx:Resources.Repeat}"
                                Visibility="{Binding IsRepeatOn, Converter={StaticResource BooleanToVisibilityConverter}}"
                                AutomationProperties.AutomationId="MusicPlayer.RepeatOnButton"
                                AutomationProperties.Name="{x:Static resx:Resources.Repeat}" />
                            <Controls:IconButton
                                Command="{Binding ToggleRepeatCommand}"
                                Icon="repeat"
                                Opacity="0.55"
                                ToolTip="{x:Static resx:Resources.Repeat}"
                                Visibility="{Binding IsRepeatOff, Converter={StaticResource BooleanToVisibilityConverter}}"
                                AutomationProperties.AutomationId="MusicPlayer.RepeatOffButton"
                                AutomationProperties.Name="{x:Static resx:Resources.Repeat}" />
                        </Grid>
                    </Grid>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="2" Header="{x:Static resx:Resources.OutputAndCommands}">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="15" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="15" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ComboBox
                            Grid.Row="0"
                            HorizontalAlignment="Stretch"
                            MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.AudioOutputDevice}"
                            ItemsSource="{Binding AudioDevices}"
                            SelectedItem="{Binding SelectedAudioDevice}"
                            Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                            AutomationProperties.AutomationId="MusicPlayer.AudioDeviceComboBox"
                            AutomationProperties.Name="{x:Static resx:Resources.AudioOutputDevice}" />

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Text="{Binding Source={x:Static resx:Resources.Volume}, StringFormat={x:Static resx:Resources.ColumnHeaderFormat}}" />
                            <Slider
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Maximum="100"
                                Minimum="0"
                                Style="{StaticResource MaterialDesign3.MaterialDesignDiscreteSlider}"
                                Value="{Binding Volume}"
                                AutomationProperties.AutomationId="MusicPlayer.VolumeSlider"
                                AutomationProperties.Name="{x:Static resx:Resources.Volume}" />
                        </Grid>
                    </Grid>

                    <GroupBox
                        Grid.Column="2"
                        VerticalAlignment="Top"
                        Header="{x:Static resx:Resources.MusicPlayerOnSongChanged}">
                        <CommandsControls:CommandListingButtonsControl
                            x:Name="OnSongChangedCommand"
                            HorizontalAlignment="Center"
                            DataContext="{Binding OnSongChangedCommand}"
                            EditClicked="OnSongChangedCommand_EditClicked"
                            HideDeleteButton="True"
                            HideEnableDisableToggle="True" />
                    </GroupBox>
                </Grid>
            </GroupBox>
        </Grid>

        <GroupBox
            Grid.Row="0"
            Grid.Column="2"
            Header="{x:Static resx:Resources.Queue}">
            <Grid>
                <TextBlock
                    MaxWidth="300"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Opacity="0.7"
                    Text="{x:Static resx:Resources.MusicPlayerQueueEmptyHint}"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Visibility="{Binding MusicNotLoaded, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <ListBox
                    x:Name="QueueListBox"
                    HorizontalContentAlignment="Stretch"
                    ItemsSource="{Binding Songs}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling"
                    Visibility="{Binding MusicLoaded, Converter={StaticResource BooleanToVisibilityConverter}}"
                    AutomationProperties.AutomationId="MusicPlayer.QueueListBox"
                    AutomationProperties.Name="{x:Static resx:Resources.Queue}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Controls:MaterialSymbolIcon
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    IconName="drag_handle" FontSize="{DynamicResource MIU.IconSize.20}"
                                    Opacity="0.6" />

                                <Grid
                                    Grid.Column="2"
                                    Width="28"
                                    Height="28"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    MouseLeftButtonDown="QueueSongBody_MouseLeftButtonDown">
                                    <Controls:MaterialSymbolIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IconName="music_note" FontSize="{DynamicResource MIU.IconSize.20}"
                                        Opacity="0.3" />
                                    <Image Source="{Binding Converter={StaticResource AlbumArtConverter}, ConverterParameter=64}" Stretch="Uniform" />
                                </Grid>

                                <StackPanel
                                    Grid.Column="4"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    MouseLeftButtonDown="QueueSongBody_MouseLeftButtonDown"
                                    Orientation="Vertical">
                                    <TextBlock
                                        FontSize="{DynamicResource MIU.FontSize.BodySmall}"
                                        Text="{Binding Title}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="{DynamicResource MIU.FontSize.LabelSmall}"
                                        Opacity="0.7"
                                        Text="{Binding QueueDetailsString}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <Button
                                    Grid.Column="6"
                                    Width="30"
                                    Height="30"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Command="{Binding DataContext.RemoveSongCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource MaterialDesignIconButton}"
                                    ToolTip="{x:Static resx:Resources.MusicPlayerRemoveFromQueue}"
                                    AutomationProperties.AutomationId="QueueRow.RemoveFromQueueButton"
                                    AutomationProperties.Name="{x:Static resx:Resources.MusicPlayerRemoveFromQueue}">
                                    <Controls:MaterialSymbolIcon
                                        IconName="cancel" FontSize="{DynamicResource MIU.IconSize.20}" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </GroupBox>

        <Grid
            Grid.Row="2"
            Grid.Column="2">
            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                <Controls:IconButton
                    Command="{Binding AddFileToQueueCommand}"
                    Icon="music_note_add"
                    ToolTip="{x:Static resx:Resources.MusicPlayerAddFileToQueue}"
                    AutomationProperties.AutomationId="MusicPlayer.AddFileButton"
                    AutomationProperties.Name="{x:Static resx:Resources.MusicPlayerAddFileToQueue}" />
                <Controls:IconButton
                    Margin="10,0,0,0"
                    Command="{Binding AddFolderToQueueCommand}"
                    Icon="library_music"
                    ToolTip="{x:Static resx:Resources.MusicPlayerAddFolderToQueue}"
                    AutomationProperties.AutomationId="MusicPlayer.AddFolderButton"
                    AutomationProperties.Name="{x:Static resx:Resources.MusicPlayerAddFolderToQueue}" />
                <Controls:IconButton
                    Margin="10,0,0,0"
                    Command="{Binding AddPlaylistToQueueCommand}"
                    Icon="queue_music"
                    ToolTip="{x:Static resx:Resources.MusicPlayerAddPlaylistToQueue}"
                    AutomationProperties.AutomationId="MusicPlayer.AddPlaylistButton"
                    AutomationProperties.Name="{x:Static resx:Resources.MusicPlayerAddPlaylistToQueue}" />
            </StackPanel>

            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Controls:IconButton
                    Command="{Binding ExportQueueCommand}"
                    Icon="upload_file"
                    ToolTip="{x:Static resx:Resources.MusicPlayerExportQueueAsPlaylist}"
                    AutomationProperties.AutomationId="MusicPlayer.ExportQueueButton"
                    AutomationProperties.Name="{x:Static resx:Resources.MusicPlayerExportQueueAsPlaylist}" />
                <Controls:IconButton
                    Margin="10,0,0,0"
                    Command="{Binding ClearQueueCommand}"
                    Icon="delete_sweep"
                    ToolTip="{x:Static resx:Resources.ClearQueue}"
                    AutomationProperties.AutomationId="MusicPlayer.ClearQueueButton"
                    AutomationProperties.Name="{x:Static resx:Resources.ClearQueue}" />
            </StackPanel>
        </Grid>
    </Grid>
</local:MainControlBase>
