<local:MainControlBase x:Class="MixItUp.WPF.Controls.MainControls.ChannelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MixItUp.WPF.Controls.MainControls"
             xmlns:util="clr-namespace:MixItUp.WPF.Util"
             xmlns:resx="clr-namespace:MixItUp.Base;assembly=MixItUp.Base"
             xmlns:Controls="clr-namespace:MixItUp.WPF.Controls"
             xmlns:MaterialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:TwitchControls="clr-namespace:MixItUp.WPF.Controls.Twitch"
             xmlns:KickControls="clr-namespace:MixItUp.WPF.Controls.Kick"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <local:MainControlBase.Resources>
        <util:LocalizationConverter x:Key="LocalizationConverter"/>
    </local:MainControlBase.Resources>

    <ScrollViewer>
        <ItemsControl HorizontalAlignment="Stretch" AutomationProperties.AutomationId="Channel.PlatformSectionsList" AutomationProperties.Name="{x:Static resx:Resources.Platforms}">

            <!-- Twitch -->

            <Border Visibility="{Binding IsTwitchConnected, Converter={StaticResource BooleanToVisibilityConverter}}" BorderBrush="{DynamicResource MaterialDesign.Brush.Primary.Dark}" BorderThickness="1">
                <Expander DataContext="{Binding Twitch}" VerticalContentAlignment="Top" HorizontalContentAlignment="Stretch" Background="{DynamicResource MaterialDesign.Brush.Primary}" IsExpanded="True" AutomationProperties.AutomationId="TwitchChannel.Expander">
                    <Expander.Header>
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="/Assets/Images/twitch-color_sm.png" Height="24" Width="24" VerticalAlignment="Center" />

                            <TextBlock Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{x:Static resx:Resources.Twitch}" Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" />
                        </Grid>
                    </Expander.Header>

                    <Grid Background="{DynamicResource MaterialDesign.Brush.Background}">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="20" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <GroupBox Grid.Row="0" Header="{x:Static resx:Resources.ChannelInfo}">
                                <Grid Margin="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="20" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="20" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <ComboBox Grid.Column="0" Text="{Binding Title}" ItemsSource="{Binding PastTitles}" IsEditable="True" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.Title}" Style="{StaticResource MaterialDesignFloatingHintComboBox}" AutomationProperties.AutomationId="TwitchChannel.TitleComboBox" AutomationProperties.Name="{x:Static resx:Resources.Title}" />

                                        <ComboBox Grid.Column="2" Text="{Binding Category}" ItemsSource="{Binding PastCategories}" IsEditable="True" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.Category}" Style="{StaticResource MaterialDesignFloatingHintComboBox}" AutomationProperties.AutomationId="TwitchChannel.CategoryComboBox" AutomationProperties.Name="{x:Static resx:Resources.Category}" />
                                    </Grid>

                                    <Grid Grid.Row="2">
                                        <TwitchControls:TwitchTagEditorControl DataContext="{Binding TagEditor}" />
                                    </Grid>

                                    <Button Grid.Row="4" Content="{x:Static resx:Resources.Update}" Command="{Binding UpdateChannelInformationCommand}" Width="150" AutomationProperties.AutomationId="TwitchChannel.UpdateChannelInfoButton" />
                                </Grid>
                            </GroupBox>

                            <GroupBox Grid.Row="2" Header="{x:Static resx:Resources.FindChannelToRaid}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="20" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" HorizontalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ComboBox Grid.Column="0" ItemsSource="{Binding SearchFindChannelToRaidOptions}" SelectedItem="{Binding SelectedSearchFindChannelToRaidOption}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.SearchCriteria}" Style="{StaticResource MaterialDesignFloatingHintComboBox}" Width="200" AutomationProperties.AutomationId="TwitchChannel.RaidSearchCriteriaComboBox" AutomationProperties.Name="{x:Static resx:Resources.SearchCriteria}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource LocalizationConverter}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <Button Grid.Column="2" Command="{Binding SearchChannelToRaidCommand}" Content="{x:Static resx:Resources.Search}" AutomationProperties.AutomationId="TwitchChannel.RaidSearchButton" />
                                    </Grid>

                                    <DataGrid Grid.Row="2" ItemsSource="{Binding ChannelsToRaid}" Style="{StaticResource StandardDataGrid}" CellStyle="{StaticResource StandardDataGridCell}" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="TwitchChannel.RaidResultsDataGrid" AutomationProperties.Name="{x:Static resx:Resources.FindChannelToRaid}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{x:Static resx:Resources.Channel}" Binding="{Binding Name}" IsReadOnly="True" Width="200" />
                                            <DataGridTextColumn Header="{x:Static resx:Resources.Viewers}" Binding="{Binding Viewers}" IsReadOnly="True" Width="100" />
                                            <DataGridTextColumn Header="{x:Static resx:Resources.Category}" Binding="{Binding Category}" IsReadOnly="True" Width="2*" />
                                            <DataGridTemplateColumn Header="{x:Static resx:Resources.Actions}" Width="125">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="10" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <Controls:IconButton Grid.Column="0" Command="{Binding OpenChannelCommand}" Icon="tv" ToolTip="{x:Static resx:Resources.OpenChannel}" AutomationProperties.AutomationId="RaidResultRow.OpenChannelButton" AutomationProperties.Name="{Binding Name, StringFormat={x:Static resx:Resources.OpenFormat}}" />

                                                            <Controls:IconButton Grid.Column="2" Command="{Binding RaidChannelCommand}" Icon="broadcast_on_personal" ToolTip="{x:Static resx:Resources.RaidChannel}" AutomationProperties.AutomationId="RaidResultRow.RaidChannelButton" AutomationProperties.Name="{Binding Name, StringFormat={x:Static resx:Resources.RaidFormat}}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </GroupBox>
                        </Grid>
                    </Grid>
                </Expander>
            </Border>

            <!-- YouTube -->
            <Border Visibility="{Binding IsYouTubeConnected, Converter={StaticResource BooleanToVisibilityConverter}}" BorderBrush="{DynamicResource MaterialDesign.Brush.Primary.Dark}" BorderThickness="1">
                <Expander DataContext="{Binding YouTube}" VerticalContentAlignment="Top" HorizontalContentAlignment="Stretch" Background="{DynamicResource MaterialDesign.Brush.Primary}" IsExpanded="True" AutomationProperties.AutomationId="YouTubeChannel.Expander">
                    <Expander.Header>
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="/Assets/Images/youtube-color_sm.png" Height="24" Width="24" VerticalAlignment="Center" />

                            <TextBlock Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{x:Static resx:Resources.YouTube}" Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" />
                        </Grid>
                    </Expander.Header>

                    <Grid Background="{DynamicResource MaterialDesign.Brush.Background}">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="20" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <GroupBox Header="{x:Static resx:Resources.ActiveBroadcasts}" Grid.Row="0">
                                <Grid Margin="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="20" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <DataGrid Grid.Row="0" ItemsSource="{Binding ActiveBroadcasts}" Style="{StaticResource StandardDataGrid}" CellStyle="{StaticResource StandardDataGridCell}" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="YouTubeChannel.ActiveBroadcastsDataGrid" AutomationProperties.Name="{x:Static resx:Resources.ActiveBroadcasts}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{x:Static resx:Resources.Name}" Binding="{Binding Display}" IsReadOnly="True" Width="*" />
                                            <DataGridTemplateColumn Header="{x:Static resx:Resources.Link}" IsReadOnly="True" Width="75">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Controls:IconButton Command="{Binding OpenStreamCommand}" Icon="tv" ToolTip="{x:Static resx:Resources.Link}" AutomationProperties.AutomationId="BroadcastRow.OpenStreamButton" AutomationProperties.Name="{Binding Name, StringFormat={x:Static resx:Resources.OpenFormat}}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ComboBox Grid.Column="0" DisplayMemberPath="Display" ItemsSource="{Binding UpcomingBroadcasts}" SelectedItem="{Binding SelectedUpcomingBroadcast}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.Broadcasts}" Style="{StaticResource MaterialDesignFloatingHintComboBox}" AutomationProperties.AutomationId="YouTubeChannel.UpcomingBroadcastsComboBox" AutomationProperties.Name="{x:Static resx:Resources.Broadcasts}" />

                                        <Button Grid.Column="2" Content="{x:Static resx:Resources.Add}" Command="{Binding AddUpcomingBroadcast}" Width="100" AutomationProperties.AutomationId="YouTubeChannel.AddUpcomingBroadcastButton" />
                                    </Grid>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="{x:Static resx:Resources.StreamInfo}" Grid.Row="2">
                                <Grid Margin="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="20" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="20" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <ComboBox Grid.Row="0" Text="{Binding Title}" ItemsSource="{Binding PastTitles}" IsEditable="True" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.Title}" Style="{StaticResource MaterialDesignFloatingHintComboBox}" AutomationProperties.AutomationId="YouTubeChannel.TitleComboBox" AutomationProperties.Name="{x:Static resx:Resources.Title}" />

                                    <TextBox Grid.Row="2" Text="{Binding Description}" AcceptsReturn="True" Height="150" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.Description}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="YouTubeChannel.DescriptionTextBox" AutomationProperties.Name="{x:Static resx:Resources.Description}" />

                                    <Button Grid.Row="4" Content="{x:Static resx:Resources.Update}" Command="{Binding UpdateChannelInformationCommand}" Width="150" AutomationProperties.AutomationId="YouTubeChannel.UpdateStreamInfoButton" />
                                </Grid>
                            </GroupBox>
                        </Grid>
                    </Grid>
                </Expander>
            </Border>
            <!-- Kick -->
            <Border Visibility="{Binding IsKickConnected, Converter={StaticResource BooleanToVisibilityConverter}}" BorderBrush="{DynamicResource MaterialDesign.Brush.Primary.Dark}" BorderThickness="1">
                <Expander DataContext="{Binding Kick}" VerticalContentAlignment="Top" HorizontalContentAlignment="Stretch" Background="{DynamicResource MaterialDesign.Brush.Primary}" IsExpanded="True" AutomationProperties.AutomationId="TrovoChannel.Expander">
                    <Expander.Header>
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="/Assets/Images/kick-color_sm.png" Height="24" Width="24" VerticalAlignment="Center" />

                            <TextBlock Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{x:Static resx:Resources.Kick}" Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" />
                        </Grid>
                    </Expander.Header>

                    <Grid Background="{DynamicResource MaterialDesign.Brush.Background}">
                        <Grid Margin="10">
                            <GroupBox Header="{x:Static resx:Resources.ChannelInfo}">
                                <Grid Margin="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="20" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="20" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <ComboBox Grid.Column="0" Text="{Binding Title}" ItemsSource="{Binding PastTitles}" IsEditable="True" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.Title}" Style="{StaticResource MaterialDesignFloatingHintComboBox}" AutomationProperties.AutomationId="TrovoChannel.TitleComboBox" AutomationProperties.Name="{x:Static resx:Resources.Title}" />

                                        <ComboBox Grid.Column="2" Text="{Binding Category}" ItemsSource="{Binding PastCategories}" IsEditable="True" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.Category}" Style="{StaticResource MaterialDesignFloatingHintComboBox}" AutomationProperties.AutomationId="TrovoChannel.CategoryComboBox" AutomationProperties.Name="{x:Static resx:Resources.Category}" />
                                    </Grid>

                                    <Grid Grid.Row="2">
                                        <KickControls:KickTagEditorControl DataContext="{Binding TagEditor}" />
                                    </Grid>

                                    <Button Grid.Row="4" Content="{x:Static resx:Resources.Update}" Command="{Binding UpdateChannelInformationCommand}" Width="150" AutomationProperties.AutomationId="TrovoChannel.UpdateChannelInfoButton" />
                                </Grid>
                            </GroupBox>
                        </Grid>
                    </Grid>
                </Expander>
            </Border>
            <!-- Velora -->
            <Border Visibility="{Binding IsVeloraConnected, Converter={StaticResource BooleanToVisibilityConverter}}" BorderBrush="{DynamicResource MaterialDesign.Brush.Primary.Dark}" BorderThickness="1">
                <Expander DataContext="{Binding Velora}" VerticalContentAlignment="Top" HorizontalContentAlignment="Stretch" Background="{DynamicResource MaterialDesign.Brush.Primary}" IsExpanded="True" AutomationProperties.AutomationId="KickChannel.Expander">
                    <Expander.Header>
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="/Assets/Images/velora-color_sm.png" Height="24" Width="24" VerticalAlignment="Center" />

                            <TextBlock Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{x:Static resx:Resources.Velora}" Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" />
                        </Grid>
                    </Expander.Header>

                    <Grid Background="{DynamicResource MaterialDesign.Brush.Background}">
                        <Grid Margin="10">
                            <GroupBox Header="{x:Static resx:Resources.ChannelInfo}">
                                <Grid Margin="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="20" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <ComboBox Grid.Column="0" Text="{Binding Title}" ItemsSource="{Binding PastTitles}" IsEditable="True" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.Title}" Style="{StaticResource MaterialDesignFloatingHintComboBox}" AutomationProperties.AutomationId="KickChannel.TitleComboBox" AutomationProperties.Name="{x:Static resx:Resources.Title}" />

                                        <ComboBox Grid.Column="2" Text="{Binding Category}" ItemsSource="{Binding PastCategories}" IsEditable="True" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.Category}" Style="{StaticResource MaterialDesignFloatingHintComboBox}" AutomationProperties.AutomationId="KickChannel.CategoryComboBox" AutomationProperties.Name="{x:Static resx:Resources.Category}" />
                                    </Grid>

                                    <Button Grid.Row="2" Content="{x:Static resx:Resources.Update}" Command="{Binding UpdateChannelInformationCommand}" Width="150" AutomationProperties.AutomationId="KickChannel.UpdateChannelInfoButton" />
                                </Grid>
                            </GroupBox>
                        </Grid>
                    </Grid>
                </Expander>
            </Border>
            <!-- VPZone -->
            <Border Visibility="{Binding IsVPZoneConnected, Converter={StaticResource BooleanToVisibilityConverter}}" BorderBrush="{DynamicResource MaterialDesign.Brush.Primary.Dark}" BorderThickness="1">
                <Expander DataContext="{Binding VPZone}" VerticalContentAlignment="Top" HorizontalContentAlignment="Stretch" Background="{DynamicResource MaterialDesign.Brush.Primary}" IsExpanded="True" AutomationProperties.AutomationId="VPZoneChannel.Expander">
                    <Expander.Header>
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="/Assets/Images/vpzone-color_sm.png" Height="24" Width="24" VerticalAlignment="Center" />

                            <TextBlock Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{x:Static resx:Resources.VPZone}" Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" />
                        </Grid>
                    </Expander.Header>

                    <Grid Background="{DynamicResource MaterialDesign.Brush.Background}">
                        <Grid Margin="10">
                            <GroupBox Header="{x:Static resx:Resources.ChannelInfo}">
                                <Grid Margin="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="20" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <ComboBox Grid.Column="0" Text="{Binding Title}" ItemsSource="{Binding PastTitles}" IsEditable="True" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.Title}" Style="{StaticResource MaterialDesignFloatingHintComboBox}" AutomationProperties.AutomationId="VPZoneChannel.TitleComboBox" AutomationProperties.Name="{x:Static resx:Resources.Title}" />

                                        <ComboBox Grid.Column="2" Text="{Binding Category}" ItemsSource="{Binding PastCategories}" IsEditable="True" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.Category}" Style="{StaticResource MaterialDesignFloatingHintComboBox}" AutomationProperties.AutomationId="VPZoneChannel.CategoryComboBox" AutomationProperties.Name="{x:Static resx:Resources.Category}" />
                                    </Grid>

                                    <Button Grid.Row="2" Content="{x:Static resx:Resources.Update}" Command="{Binding UpdateChannelInformationCommand}" Width="150" AutomationProperties.AutomationId="VPZoneChannel.UpdateChannelInfoButton" />
                                </Grid>
                            </GroupBox>
                        </Grid>
                    </Grid>
                </Expander>
            </Border>
        </ItemsControl>
    </ScrollViewer>
</local:MainControlBase>