<local:GroupedCommandsMainControlBase x:Class="MixItUp.WPF.Controls.MainControls.StreamlootsCardsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MixItUp.WPF.Controls.MainControls"
             xmlns:resx="clr-namespace:MixItUp.Base;assembly=MixItUp.Base"
             xmlns:System="clr-namespace:System;assembly=System.Runtime"
             xmlns:Controls="clr-namespace:MixItUp.WPF.Controls"
             xmlns:CommandsControls="clr-namespace:MixItUp.WPF.Controls.Commands"
             xmlns:MaterialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="500">
    <local:MainControlBase.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </local:MainControlBase.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding Source={x:Static resx:Resources.FilterByName}, StringFormat={x:Static resx:Resources.ColumnHeaderFormat}}" />

            <TextBox Grid.Column="2" x:Name="StreamlootsCardsNameFilterTextBox" Width="150" TextChanged="NameFilterTextBox_TextChanged" AutomationProperties.AutomationId="StreamlootsCards.NameFilterTextBox" AutomationProperties.Name="{x:Static resx:Resources.FilterByName}" />
        </Grid>

        <ScrollViewer Grid.Row="2" Visibility="{Binding ShowList, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
            <DataGrid ItemsSource="{Binding DefaultGroup}" Style="{StaticResource StandardDataGrid}" CellStyle="{StaticResource StandardDataGridCell}" HorizontalContentAlignment="Stretch" PreviewMouseWheel="DataGrid_PreviewMouseWheel" AutomationProperties.AutomationId="StreamlootsCards.CommandsDataGrid" AutomationProperties.Name="{x:Static resx:Resources.Commands}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{x:Static resx:Resources.StreamlootsCardName}" Binding="{Binding Name}" IsReadOnly="True" Width="*" />
                    <DataGridTemplateColumn Header="{x:Static resx:Resources.Actions}" MinWidth="250" Width="250">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CommandsControls:CommandListingButtonsControl HorizontalAlignment="Center" EditClicked="CommandButtons_EditClicked" DeleteClicked="CommandButtons_DeleteClicked" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </ScrollViewer>

        <ScrollViewer Grid.Row="2" Visibility="{Binding ShowGroups, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding CommandGroups}" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="StreamlootsCards.CommandGroupsList" AutomationProperties.Name="{x:Static resx:Resources.CommandGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource MaterialDesign.Brush.Primary.Dark}" BorderThickness="1">
                            <Expander VerticalContentAlignment="Top" HorizontalContentAlignment="Stretch" Visibility="{Binding HasCommands, Converter={StaticResource BooleanToVisibilityConverter}}" Background="{DynamicResource MaterialDesign.Brush.Primary}" AutomationProperties.AutomationId="CommandGroup.Expander">
                                <Expander.Header>
                                    <Grid Background="Transparent">
                                        <TextBlock HorizontalAlignment="Left" Text="{Binding DisplayName}" Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" />

                                        <ToggleButton Visibility="{Binding IsEnableSwitchToggable, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource MaterialDesignSwitchLightToggleButton}" BorderBrush="{DynamicResource MaterialDesign.Brush.Primary.Light}" HorizontalAlignment="Right" IsChecked="{Binding Path=IsEnabled}" AutomationProperties.AutomationId="CommandGroup.EnableDisableToggle" AutomationProperties.Name="{Binding DisplayName, StringFormat={x:Static resx:Resources.EnableDisableFormat}}" />
                                    </Grid>
                                </Expander.Header>

                                <DataGrid ItemsSource="{Binding Commands}" Style="{StaticResource StandardDataGrid}" CellStyle="{StaticResource StandardDataGridCell}" HorizontalContentAlignment="Stretch" PreviewMouseWheel="DataGrid_PreviewMouseWheel" AutomationProperties.AutomationId="CommandGroup.CommandsDataGrid" AutomationProperties.Name="{x:Static resx:Resources.Commands}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{x:Static resx:Resources.StreamlootsCardName}" Binding="{Binding Name}" IsReadOnly="True" Width="*" />
                                        <DataGridTemplateColumn Header="{x:Static resx:Resources.Actions}" MinWidth="230" Width="230">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CommandsControls:CommandListingButtonsControl HorizontalAlignment="Center" EditClicked="CommandButtons_EditClicked" DeleteClicked="CommandButtons_DeleteClicked" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Expander>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="4" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="StreamlootsCardsAddCommandButton" Grid.Column="0" Click="AddCommandButton_Click" Content="{x:Static resx:Resources.AddCommand}" MinWidth="140" AutomationProperties.AutomationId="StreamlootsCards.AddCommandButton" />

            <Button x:Name="StreamlootsCardsChannelPointsEditorButton" Grid.Column="2" Command="{Binding StreamlootsManageCollectionCommand}" Width="195" AutomationProperties.AutomationId="StreamlootsCards.ManageCollectionButton">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{x:Static resx:Resources.StreamlootsManageCollection}" />
                    <Controls:MaterialSymbolIcon IconName="open_in_new" FontSize="{DynamicResource MIU.IconSize.20}" Margin="5,0,0,0" Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</local:GroupedCommandsMainControlBase>