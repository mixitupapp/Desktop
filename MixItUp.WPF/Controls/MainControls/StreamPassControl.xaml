<local:MainControlBase x:Class="MixItUp.WPF.Controls.MainControls.StreamPassControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MixItUp.WPF.Controls.MainControls"
             xmlns:resx="clr-namespace:MixItUp.Base;assembly=MixItUp.Base"
             xmlns:System="clr-namespace:System;assembly=System.Runtime"
             xmlns:Controls="clr-namespace:MixItUp.WPF.Controls"
             xmlns:MaterialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="500">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DataGrid Grid.Row="0" ItemsSource="{Binding StreamPasses}" Style="{StaticResource StandardDataGrid}" CellStyle="{StaticResource StandardDataGridCell}" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="StreamPass.StreamPassesDataGrid" AutomationProperties.Name="{x:Static resx:Resources.StreamPass}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static resx:Resources.Name}" Binding="{Binding Name}" IsReadOnly="True" Width="*" />
                <DataGridTextColumn Header="{x:Static resx:Resources.SpecialIdentifiers}" Binding="{Binding SpecialIdentifiersReferenceDisplay}" IsReadOnly="True" Width="180" />
                <DataGridTextColumn Header="{x:Static resx:Resources.DateRange}" Binding="{Binding DateRangeString}" IsReadOnly="True" Width="180" />
                <DataGridTemplateColumn Header="{x:Static resx:Resources.Actions}" Width="175">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Controls:IconButton Grid.Column="0" x:Name="StreamPassEditButton" Click="EditButton_Click" HorizontalAlignment="Center" Icon="rate_review" ToolTip="{x:Static resx:Resources.Edit}" AutomationProperties.AutomationId="StreamPassRow.EditButton" AutomationProperties.Name="{Binding Name, StringFormat={x:Static resx:Resources.EditCommandFormat}}" />

                                <Controls:IconButton Grid.Column="2" x:Name="CopyButton" Click="CopyButton_Click" HorizontalAlignment="Center" Icon="content_copy" ToolTip="{x:Static resx:Resources.Copy}" AutomationProperties.AutomationId="StreamPassRow.CopyButton" AutomationProperties.Name="{Binding Name, StringFormat={x:Static resx:Resources.CopyFormat}}" />

                                <Controls:IconButton Grid.Column="4" x:Name="StreamPassDeleteButton" Click="DeleteButton_Click" HorizontalAlignment="Center" Icon="delete" ToolTip="{x:Static resx:Resources.Delete}" AutomationProperties.AutomationId="StreamPassRow.DeleteButton" AutomationProperties.Name="{Binding Name, StringFormat={x:Static resx:Resources.DeleteCommandFormat}}" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2">
            <Button Grid.Column="2" x:Name="AddStreamPassButton" Click="AddStreamPassButton_Click" Content="{x:Static resx:Resources.AddStreamPass}" Width="200" AutomationProperties.AutomationId="StreamPass.AddStreamPassButton" />
        </Grid>
    </Grid>
</local:MainControlBase>