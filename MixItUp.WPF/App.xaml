<Application
    x:Class="MixItUp.WPF.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MixItUp.WPF"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    ShutdownMode="OnMainWindowClose"
    StartupUri="LoginWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme
                    BaseTheme="Light"
                    PrimaryColor="Indigo"
                    SecondaryColor="Lime" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
                <ResourceDictionary Source="Themes/MixItUpBackgroundColor.Light.xaml" />
                <ResourceDictionary Source="Themes/ColorPickerStyle.xaml" />
                <ResourceDictionary Source="Themes/MixItUp.MD3.Core.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <FontFamily x:Key="BebasNeue">pack://application:,,,/Assets/Fonts/BebasNeue.otf#Bebas Neue</FontFamily>
            <!--  Folder-based reference composes all embedded Noto Sans faces (Regular/Medium/Bold) into one family  -->
            <FontFamily x:Key="NotoSans">pack://application:,,,/Assets/Fonts/#Noto Sans</FontFamily>
            <!--  Shadow the MaterialDesignThemes font key so DynamicResource lookups resolve to Noto Sans instead of Roboto  -->
            <FontFamily x:Key="MaterialDesignFont">pack://application:,,,/Assets/Fonts/#Noto Sans</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>