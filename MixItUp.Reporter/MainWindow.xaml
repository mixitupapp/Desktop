<Window
    x:Class="MixItUp.Reporter.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MixItUp.Reporter"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:MixItUp.Reporter.Properties"
    Title="{x:Static resx:Resources.Title}"
    Width="520"
    Height="550"
    Background="{DynamicResource MaterialDesignPaper}"
    FontFamily="{materialDesign:MaterialDesignFont}"
    Icon="./Logo.ico"
    TextElement.FontSize="14"
    TextElement.FontWeight="Medium"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <materialDesign:DialogHost x:Name="MDDialogHost" Identifier="RootDialog" />
        <Grid
            Grid.Row="0"
            Margin="20,15,20,15"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="28" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
                Grid.Row="0"
                Width="440"
                HorizontalAlignment="Center"
                FontSize="14"
                Text="{x:Static resx:Resources.DialogDescription}"
                TextWrapping="Wrap" />
            <TextBox
                x:Name="IssueDescriptionTextBox"
                Grid.Row="2"
                Width="440"
                Height="140"
                materialDesign:HintAssist.Hint="{x:Static resx:Resources.IssueDescription}"
                AcceptsReturn="True"
                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                VerticalScrollBarVisibility="Auto" />
            <TextBox
                x:Name="ReplyEmailTextBox"
                Grid.Row="4"
                Width="440"
                materialDesign:HintAssist.Hint="{x:Static resx:Resources.Email}"
                Style="{StaticResource MaterialDesignOutlinedTextBox}" />
            <Grid Grid.Row="6" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="ReportIssueButton"
                    Grid.Column="0"
                    Height="40"
                    Padding="24,10"
                    Click="ReportIssueButton_Click"
                    Content="{x:Static resx:Resources.ReportIssue}"
                    Style="{StaticResource MaterialDesignRaisedButton}" />
                <Button
                    x:Name="OpenLogFileButton"
                    Grid.Column="2"
                    Height="40"
                    Padding="24,10"
                    Click="OpenLogFileButton_Click"
                    Content="{x:Static resx:Resources.OpenLogFile}"
                    Style="{StaticResource MaterialDesignOutlinedButton}" />
            </Grid>

            <Grid Grid.Row="8" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    HorizontalAlignment="Center"
                    FontSize="12.5"
                    Foreground="{DynamicResource MaterialDesignBodyLight}"
                    Text="Prefer not to share your email? Join the Discord for follow up" />

                <Button
                    x:Name="JoinDiscordButton"
                    Grid.Row="2"
                    Height="40"
                    Padding="24,10"
                    HorizontalAlignment="Center"
                    Click="JoinDiscordButton_Click"
                    Content="Join Discord"
                    Style="{StaticResource MaterialDesignOutlinedButton}" />
            </Grid>
        </Grid>
        <ProgressBar
            x:Name="StatusBar"
            Grid.Row="1"
            IsIndeterminate="True"
            Visibility="Hidden" />
    </Grid>
</Window>